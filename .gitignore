# --- OS / editor junk ---
.DS_Store
Thumbs.db
*~
*.swp
*.swo
*.swn
*.bak
*.backup
*.orig
*.tmp
.99.debug

# --- Backup directories ---
*-backup*/
.codex-backup*/

# --- Secrets / auth (never public) ---
github-copilot/
fish/local/

# --- Nested upstream repo ---
init.lua/

# --- Machine-local runtime state ---
fish/fish_variables
nvim/tmp/
zed/prompts/

# --- Large / downloaded app data ---
raycast-x/
node_modules/

# --- Logs / caches (defensive) ---
*.log
.cache/

# --- Herdr runtime (keep config.toml) ---
herdr/*.sock
herdr/session.json
herdr/session-history.json
herdr/release-notes.json
.claude/plans

# --- Claude Code: never let sensitive ~/.claude subpaths land under claude/ ---
claude/settings.local.json
**/.claude.json
**/.claude.json.backup.*
**/.claude/backups/
**/.claude/projects/
**/.claude/sessions/
**/.claude/session-env/
**/.claude/shell-snapshots/
**/.claude/daemon/
**/.claude/daemon.log
**/.claude/telemetry/
**/.claude/debug/
**/.claude/history.jsonl
**/.claude/tasks/
**/.claude/jobs/
**/.claude/file-history/
**/.claude/downloads/
**/.claude/cache/
**/.claude/.last-cleanup
**/.claude/.last-update-result.json
**/.claude/mcp-needs-auth-cache.json
**/.claude/plugins/cache/
**/.claude/plugins/marketplaces/
**/.claude/plugins/plugin-catalog-cache.json
**/.claude/settings.json.backup.*

# --- Same protection, repo-relative (in case ~/.claude subpaths get copied
#     flat into the tracked claude/ mirror rather than nested under .claude/) ---
claude/.claude.json
claude/.claude.json.backup.*
claude/backups/
claude/projects/
claude/sessions/
claude/session-env/
claude/shell-snapshots/
claude/daemon/
claude/daemon.log
claude/telemetry/
claude/debug/
claude/history.jsonl
claude/tasks/
claude/jobs/
claude/file-history/
claude/downloads/
claude/cache/
claude/.last-cleanup
claude/.last-update-result.json
claude/mcp-needs-auth-cache.json
claude/plugins/cache/
claude/plugins/marketplaces/
claude/plugins/plugin-catalog-cache.json
claude/settings.json.backup.*
