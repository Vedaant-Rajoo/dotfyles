# --- OS / editor junk ---
.DS_Store
Thumbs.db
*~
*.swp
*.swo
*.swn
*.bak
*.backup
*.orig
*.tmp
.99.debug

# --- Backup directories ---
*-backup*/
.codex-backup*/

# --- Secrets / auth (never public) ---
github-copilot/
fish/local/
monid/credentials.yaml
opencode/opencode.json
claude/auth-token

# --- Nested upstream repo ---
init.lua/

# --- Generated harness projections. ~/.config/opencode IS this repo's
#     opencode/, and ~/.claude is a symlink to this repo's claude/, so
#     bin/agents_link writes translated subagents into the working tree;
#     agents/subagents/ is the tracked source. ---
opencode/agents/
claude/agents/

# --- Machine-local runtime state ---
fish/fish_variables
nvim/tmp/
zed/prompts/

# --- Fish plugins: Fisher installs straight into this repo ($fisher_path
#     defaults to $__fish_config_dir), so its output lands in the working tree.
#     fish_plugins is the source of truth; tracking the installed files as well
#     meant 82 vendored third-party files plus a bootstrap hack to seed
#     _fisher_plugins so `fisher update` would not treat them as conflicts.
#     Ignore what Fisher writes and whitelist the hand-written config. New
#     config files must be whitelisted here on purpose. Note that Pure owns
#     fish_prompt.fish, fish_mode_prompt.fish, and fish_title.fish -- those
#     look hand-written but are plugin output. ---
fish/themes/
fish/functions/*
!fish/functions/bin-chmod.fish
!fish/functions/reload.fish
fish/conf.d/*
!fish/conf.d/00-paths.fish
!fish/conf.d/10-env.fish
!fish/conf.d/20-abbreviations.fish
!fish/conf.d/30-fzf.fish
!fish/conf.d/35-herdr-sessionizer.fish
!fish/conf.d/36-claude-model-picker.fish
!fish/conf.d/40-zoxide.fish
!fish/conf.d/45-zig.fish
!fish/conf.d/50-node.fish
!fish/conf.d/55-python.fish
!fish/conf.d/60-pure.fish
!fish/conf.d/rustup.fish
fish/completions/*
!fish/completions/bun.fish
!fish/completions/docker.fish
!fish/completions/herdr.fish
!fish/completions/kubectl.fish
!fish/completions/orbctl.fish

# --- AI planning artifacts: specs and plans are process scaffolding for a
#     change, not system state; they never belong in the repo. ---
docs/superpowers/

# --- Large / downloaded app data ---
raycast/
raycast-x/
node_modules/

# --- Legcord: only storage/settings.json is tracked. On Linux the app's
#     Electron userData dir IS ~/.config/legcord, so session cookies and
#     caches would otherwise land here; bin/legcord_link documents this. ---
legcord/*
!legcord/storage
legcord/storage/*
!legcord/storage/settings.json

# --- Logs / caches (defensive) ---
*.log
.cache/
__pycache__/

# --- Herdr runtime (keep config.toml) ---
herdr/*.sock
herdr/.plugins.lock
herdr/session.json
herdr/session-history.json
herdr/release-notes.json

# --- Claude Code, project-local: generated plan pages. The sensitive
#     **/.claude runtime paths (projects, sessions, credentials, …) are NOT
#     listed here: git/ignore — the global excludes file this repo itself
#     provides at $XDG_CONFIG_HOME/git/ignore — already covers them for every
#     repo on the machine, and a second hand-synced copy would only drift. ---
.claude/plans

# --- Claude Code, repo-relative: ~/.claude IS this repo's claude/, so the live
#     runtime keeps inventing new state files here (caches, transcripts,
#     credentials). Enumerating known paths cannot keep up with that, so ignore
#     everything under claude/ and whitelist the tracked configuration; a new
#     runtime file can then never ride into a commit on `git add -A`. New
#     config files must be whitelisted here on purpose. ---
claude/*
!claude/README.md
!claude/CLAUDE.md
!claude/api-key-helper.sh
!claude/hooks/
!claude/settings.json
!claude/skills
!claude/statusline-command.sh
