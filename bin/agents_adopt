#!/usr/bin/env bash
# agents_adopt — promote a skill that was installed straight into
# ~/.agents/skills (typically by `npx skills add --global`) into this
# repository, so every harness reads it from one tracked copy.
#
# ~/.agents/skills is the ecosystem's canonical install target, and installers
# have no idea this repo exists. What they leave behind works on this machine
# and disappears on the next one. Adopting moves the directory into
# agents/skills and lets agents_link put a symlink back where it was.
#
# Usage:
#   agents_adopt <name>            Adopt the skill and reproject every harness.
#   agents_adopt --dry-run <name>  Print what that would do, change nothing.
#
# Nothing is committed. Read the adopted files before staging them: they came
# from outside this repository and nothing under agents/ may carry credentials.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SHARED_SKILLS="$HOME/.agents/skills"
REPO_SKILLS="$REPO_ROOT/agents/skills"
DRY_RUN=0
NAME=""

USE_GUM=0
if command -v gum >/dev/null 2>&1 && [[ -t 1 ]]; then
	USE_GUM=1
fi

usage() {
	cat <<'EOF'
usage: agents_adopt [--dry-run] <name>

Move ~/.agents/skills/<name> into agents/skills/<name>, then re-run
bin/agents_link all so every harness links to the tracked copy.
EOF
}

say() {
	local status="$1"
	shift
	if [[ "$USE_GUM" -eq 0 ]]; then
		printf '%-8s%s\n' "$status" "$*"
		return
	fi
	local color=7
	case "$status" in
	ok: | moved: | done:) color=2 ;;
	next:) color=3 ;;
	error:) color=1 ;;
	INFO) color=4 ;;
	esac
	printf '%s%s\n' "$(CLICOLOR_FORCE=1 gum style --bold --foreground "$color" "$(printf '%-8s' "$status")")" "$*"
}

die() {
	say 'error:' "$*" >&2
	exit 1
}

for arg in "$@"; do
	case "$arg" in
	--dry-run) DRY_RUN=1 ;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		usage >&2
		exit 1
		;;
	*)
		[[ -z "$NAME" ]] || die "adopt one skill at a time"
		NAME="$arg"
		;;
	esac
done

[[ -n "$NAME" ]] || {
	usage >&2
	exit 1
}

source_dir="$SHARED_SKILLS/$NAME"
dest_dir="$REPO_SKILLS/$NAME"

# The name becomes a directory name, a symlink name, and a skill id in four
# harnesses, so it has to be boring.
[[ "$NAME" =~ ^[a-z0-9][a-z0-9._-]*$ ]] ||
	die "'$NAME' is not a usable skill name (expected ^[a-z0-9][a-z0-9._-]*\$)"

[[ -e "$source_dir" ]] || die "no skill at $source_dir"

# A symlink here is already managed — either by this repo or by another tool
# that owns the real copy. Either way, moving it would move someone else's file.
[[ ! -L "$source_dir" ]] ||
	die "$source_dir is a symlink to $(readlink "$source_dir"); only a real directory can be adopted"
[[ -d "$source_dir" ]] || die "$source_dir is not a directory"
[[ -f "$source_dir/SKILL.md" ]] || die "$source_dir has no SKILL.md, so no harness can load it"

grep -qxF "name: $NAME" "$source_dir/SKILL.md" ||
	die "$source_dir/SKILL.md does not declare 'name: $NAME'; fix the frontmatter first"

# ~/.claude/skills resolves through claude/skills into agents/skills, so a skill
# an installer dropped on the Claude side is already sitting at the destination.
if [[ -e "$dest_dir" ]]; then
	die "$dest_dir already exists — an installer may have written it through
        ~/.claude/skills. Compare the two copies and remove one, then re-run."
fi

if [[ "$DRY_RUN" -eq 1 ]]; then
	say INFO "would move $source_dir -> $dest_dir"
	say INFO "would run bin/agents_link all"
	printf '\n'
	say INFO "contents:"
	find "$source_dir" -type f | sed "s|^$source_dir/|  |"
	exit 0
fi

mkdir -p "$REPO_SKILLS"
mv "$source_dir" "$dest_dir"
say 'moved:' "$NAME -> agents/skills/$NAME"

printf '\n'
"$REPO_ROOT/bin/agents_link" all || say INFO "agents_link reported drift above; the adopted skill itself is in place"

printf '\n'
say 'done:' "$NAME is now canonical and shared by every installed harness"
say 'next:' "review it, then track it:"
printf '  git -C %s status --short agents/skills/%s\n' "$REPO_ROOT" "$NAME"
printf '  git -C %s add agents/skills/%s\n' "$REPO_ROOT" "$NAME"
say INFO "nothing was committed; adopted files came from outside this repository"
