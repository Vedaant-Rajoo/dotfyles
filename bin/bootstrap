#!/usr/bin/env bash
# Bootstrap a fresh macOS machine from this repository.

set -euo pipefail

POSTPLAN_VERSION="0.0.4"

DRY_RUN=0
WITH_DEFAULTS=0
WITH_HERDR_SERVICE=0

usage() {
	cat <<'EOF'
usage: bin/bootstrap [--dry-run] [--with-defaults] [--with-herdr-service]

  --dry-run             Print mutations without running them.
  --with-defaults       Apply bin/macdefaults after package setup.
  --with-herdr-service  Start Herdr as a Homebrew service.
EOF
}

quote_command() {
	local arg
	printf 'would run:'
	for arg in "$@"; do
		printf ' %q' "$arg"
	done
	printf '\n'
}

warn() {
	printf 'warning: %s\n' "$*" >&2
}

die() {
	printf 'bootstrap: %s\n' "$*" >&2
	exit 1
}

# True in print-only mode. Guarding every state probe with `dry_run ||` makes
# --dry-run a static plan: it lists what a fresh machine would do, instead of
# what this machine still needs.
dry_run() {
	[[ "$DRY_RUN" -eq 1 ]]
}

run() {
	if dry_run; then
		quote_command "$@"
		return 0
	fi
	"$@"
}

# A fresh machine has none of the Brewfile's tools during a dry run, so assume
# they are present and let the `dry_run ||` probes decide what gets printed.
have() {
	if dry_run; then
		return 0
	fi
	command -v "$1" >/dev/null 2>&1
}

# `eval "$(tool env)"` cannot route through `run` -- it must affect this shell.
load_env() {
	if dry_run; then
		printf 'would load: %s\n' "$*"
		return 0
	fi
	eval "$("$@")"
}

for arg in "$@"; do
	case "$arg" in
	--dry-run)
		DRY_RUN=1
		;;
	--with-defaults)
		WITH_DEFAULTS=1
		;;
	--with-herdr-service)
		WITH_HERDR_SERVICE=1
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 1
		;;
	esac
done

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
EXPECTED_ROOT="$(cd "$HOME/.config" 2>/dev/null && pwd -P || true)"

if [[ "$DRY_RUN" -eq 0 && "$REPO_ROOT" != "$EXPECTED_ROOT" ]]; then
	die "clone this repository directly to $HOME/.config before running bootstrap"
fi

if [[ "$(uname -s)" != "Darwin" ]]; then
	die "automatic setup currently supports macOS only; see README.md#linux"
fi

BREWFILE="$REPO_ROOT/Brewfile"

# Toolchain versions live in the files fnm and pyenv already read natively --
# `fnm env --use-on-cd` and `pyenv init -` are both active in fish/conf.d -- so
# the pin is data this script consumes rather than a constant it owns.
read_pin() {
	local file="$REPO_ROOT/$1"
	[[ -r "$file" ]] || die "missing version pin: $1"
	tr -d '[:space:]' <"$file"
}

NODE_VERSION="$(read_pin .node-version)"
PYTHON_VERSION="$(read_pin .python-version)"

printf '\n==> Xcode Command Line Tools\n'
if dry_run || ! xcode-select -p >/dev/null 2>&1; then
	run xcode-select --install
	if ! dry_run; then
		echo "Re-run bin/bootstrap after the Command Line Tools installation finishes."
		exit 1
	fi
fi

printf '\n==> Homebrew\n'
# A real `command -v` even in dry-run: BREW_PREFIX has to come from the live
# install when there is one, and "would install Homebrew" is not a step a
# machine that already has it would take.
if command -v brew >/dev/null 2>&1; then
	BREW_PREFIX="$(brew --prefix)"
else
	case "$(uname -m)" in
	arm64) BREW_PREFIX="/opt/homebrew" ;;
	x86_64) BREW_PREFIX="/usr/local" ;;
	*) die "unsupported architecture: $(uname -m)" ;;
	esac

	run /bin/bash -c 'curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh | /bin/bash'
fi
load_env "$BREW_PREFIX/bin/brew" shellenv

if have brew; then
	# Two passes so an unsigned-in App Store cannot abort the run. Pass 1 is
	# everything but the Mac App Store and stays fatal on failure.
	if dry_run || ! env HOMEBREW_BUNDLE_MAS_SKIP=1 brew bundle check --file="$BREWFILE" >/dev/null 2>&1; then
		run env HOMEBREW_BUNDLE_MAS_SKIP=1 brew bundle install --file="$BREWFILE"
	else
		echo "Brewfile formulae and casks are already satisfied."
	fi

	# Pass 2: only the mas entries are left. brew bundle owns the Brewfile
	# format and reports App Store failures itself, so this only has to
	# downgrade them to a warning.
	if dry_run || ! brew bundle check --file="$BREWFILE" >/dev/null 2>&1; then
		if ! run brew bundle install --file="$BREWFILE"; then
			warn "Mac App Store installs did not complete; sign in to the App Store, then re-run bootstrap"
		fi
	fi
else
	die "Homebrew installation did not complete"
fi

printf '\n==> Fish login shell\n'
if [[ -x "$BREW_PREFIX/bin/fish" ]]; then
	FISH_BIN="$BREW_PREFIX/bin/fish"
elif [[ -x /usr/local/bin/fish ]]; then
	FISH_BIN="/usr/local/bin/fish"
else
	FISH_BIN="$BREW_PREFIX/bin/fish"
	dry_run || die "Fish was not installed by the Brewfile"
fi

if dry_run || ! grep -qxF "$FISH_BIN" /etc/shells; then
	run sudo /bin/sh -c "printf '%s\\n' '$FISH_BIN' >> /etc/shells"
fi

if dry_run || [[ "$(dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}')" != "$FISH_BIN" ]]; then
	run chsh -s "$FISH_BIN"
fi

printf '\n==> Node %s via fnm\n' "$NODE_VERSION"
export FNM_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fnm"
if have fnm; then
	if dry_run || ! fnm list 2>/dev/null | grep -Eq "(^|[^0-9])v?${NODE_VERSION}([^0-9]|$)"; then
		run fnm install "$NODE_VERSION"
	fi
	if dry_run || ! fnm default 2>/dev/null | grep -q "$NODE_VERSION"; then
		run fnm default "$NODE_VERSION"
	fi
	load_env fnm env --shell bash
else
	die "fnm was not installed by the Brewfile"
fi

printf '\n==> Python %s via pyenv\n' "$PYTHON_VERSION"
if have pyenv; then
	if dry_run || ! pyenv versions --bare 2>/dev/null | grep -qx "$PYTHON_VERSION"; then
		run pyenv install -s "$PYTHON_VERSION"
	fi
	if dry_run || [[ "$(pyenv global 2>/dev/null || true)" != "$PYTHON_VERSION" ]]; then
		run pyenv global "$PYTHON_VERSION"
	fi
else
	die "pyenv was not installed by the Brewfile"
fi

printf '\n==> npm global tools\n'
export npm_config_prefix="$HOME/.node_modules"
NPM_GLOBALS=(
	"postplan@$POSTPLAN_VERSION"
	"@augmentcode/auggie"
	"localtunnel"
)
NPM_GLOBAL_ENTRIES=()

# One `npm ls` answers every spec. Multi-argument `npm ls` cannot stand in for
# it: with several filters it exits 0 when *any* of them matches, so the whole
# global tree gets read once here instead.
read_npm_globals() {
	local entry
	while IFS= read -r entry; do
		if [[ -n "$entry" ]]; then
			NPM_GLOBAL_ENTRIES+=("$entry")
		fi
	done < <(npm ls -g --depth=0 --json 2>/dev/null |
		jq -r '.dependencies // {} | to_entries[] | "\(.key)@\(.value.version)"' 2>/dev/null)
}

# An entry satisfies a spec either exactly ("postplan@0.0.4") or by name alone,
# for unpinned specs. ${entry%@*} strips the version and leaves scoped names
# ("@augmentcode/auggie") intact.
npm_global_present() {
	local spec="$1" entry
	if [[ ${#NPM_GLOBAL_ENTRIES[@]} -eq 0 ]]; then
		return 1
	fi
	for entry in "${NPM_GLOBAL_ENTRIES[@]}"; do
		if [[ "$entry" == "$spec" || "${entry%@*}" == "$spec" ]]; then
			return 0
		fi
	done
	return 1
}

if have npm; then
	# No snapshot in dry-run, or without jq: everything reads as missing, which
	# is the safe answer -- `npm install -g` on an installed spec is a no-op.
	if ! dry_run && have jq; then
		read_npm_globals
	fi

	NPM_MISSING=()
	for spec in "${NPM_GLOBALS[@]}"; do
		if ! npm_global_present "$spec"; then
			NPM_MISSING+=("$spec")
		fi
	done

	if [[ ${#NPM_MISSING[@]} -gt 0 ]]; then
		run npm install -g "${NPM_MISSING[@]}"
	fi
else
	warn "npm is unavailable; re-run bootstrap after fnm activates Node $NODE_VERSION"
fi

printf '\n==> AI harness configuration\n'
if dry_run || ! command -v claude >/dev/null 2>&1; then
	run /bin/bash -c 'curl -fsSL https://claude.ai/install.sh | bash'
fi
if ! run "$REPO_ROOT/bin/agents_link" all; then
	warn "agent links were seeded, but one or more adapters need attention"
	warn "write your CLIProxyAPI token into claude/auth-token, then re-run bin/agents_link all"
	warn "if ~/.claude is still a real directory, fold it in with bin/agents_link --migrate claude"
fi

printf '\n==> Legcord settings\n'
if ! run "$REPO_ROOT/bin/legcord_link"; then
	warn "Legcord settings link failed; run bin/legcord_link again after launching Legcord once"
fi

printf '\n==> T3 Code activity wake hold\n'
if ! run "$REPO_ROOT/bin/t3_awake" install; then
	warn "t3_awake install failed; run bin/t3_awake install again after launching T3 Code once"
fi

printf '\n==> Repository hooks\n'
run git -C "$REPO_ROOT" config core.hooksPath git/hooks

printf '\n==> Fisher plugins\n'
# fish_plugins is the source of truth and .gitignore keeps Fisher's output
# untracked. Nothing is vendored, so `fisher update` has no conflicting files
# to trip over and needs no seeded _fisher_plugins state.
run "$FISH_BIN" -c '
	if not functions -q fisher
		curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
		and fisher install jorgebucaran/fisher
	end
	fisher update
'

if [[ "$WITH_DEFAULTS" -eq 1 ]]; then
	printf '\n==> macOS defaults\n'
	run "$FISH_BIN" "$REPO_ROOT/bin/macdefaults"
fi

if [[ "$WITH_HERDR_SERVICE" -eq 1 ]]; then
	printf '\n==> Herdr service\n'
	if dry_run || ! brew services list 2>/dev/null | awk '$1 == "herdr" && $2 == "started" { found = 1 } END { exit !found }'; then
		run brew services start herdr
	else
		echo "Herdr service is already running."
	fi
fi

cat <<'EOF'

Bootstrap complete. Remaining machine-local steps:
  - Sign in to the App Store and re-run bootstrap if any mas installs failed.
  - Run `gh auth login`, configure SSH access, and switch the remote to SSH.
  - Add ~/.wakatime.cfg, opencode/opencode.json, and fish/local/ secrets.
  - Write your CLIProxyAPI token into claude/auth-token, then run bin/agents_link all.
  - Run `postplan login` and open Neovim once to install plugins.

See README.md for the complete checklist and SYSTEM.md for snapshot provenance.
EOF
