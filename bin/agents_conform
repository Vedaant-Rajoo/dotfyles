#!/usr/bin/env bash
# Verify that installed harnesses are wired to agents/, then optionally run
# token-burning behavioral canaries through their one-shot interfaces.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
. "$REPO_ROOT/bin/lib/ui.sh"
LIVE=0
LIVE_SKILLS=0
TIMEOUT_SECONDS="${AGENTS_CONFORM_TIMEOUT:-120}"

usage() {
	cat <<'EOF'
usage: agents_conform [--live] [--skills]

  --live    Run rule and hook canaries through installed harness CLIs.
  --skills  With --live, also ask each model to invoke every skill that
            publishes a SKILL-CHECK contract line in its own SKILL.md.

The static tier is deterministic and returns non-zero on drift. Live checks use
models and tokens; their scorecard is informational unless AGENTS_LIVE_GATE=1.
EOF
}

for arg in "$@"; do
	case "$arg" in
	--live) LIVE=1 ;;
	--skills) LIVE_SKILLS=1 ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 1
		;;
	esac
done

if [[ "$LIVE_SKILLS" -eq 1 && "$LIVE" -eq 0 ]]; then
	echo "agents_conform: --skills requires --live" >&2
	exit 1
fi

header() {
	local title="$1"
	if [[ "$USE_GUM" -eq 1 ]]; then
		gum style --bold --border rounded --border-foreground 4 --padding "0 2" "$title"
	else
		printf '%s\n%s\n' "$title" "${title//?/=}"
	fi
}

verdict() {
	local color="$1"
	shift
	if [[ "$USE_GUM" -eq 1 ]]; then
		printf '\n%s\n' "$(CLICOLOR_FORCE=1 gum style --bold --foreground "$color" "$*")"
	else
		printf '\n%s\n' "$*"
	fi
}

static_failed=0
header 'Static conformance'
if ! "$REPO_ROOT/bin/agents_link" --check all; then
	static_failed=1
fi

check_repo_link() {
	if [[ -L "$REPO_ROOT/AGENTS.md" ]] && [[ "$REPO_ROOT/AGENTS.md" -ef "$REPO_ROOT/agents/AGENTS.md" ]]; then
		say OK "repository AGENTS.md"
	else
		say BROKEN "repository AGENTS.md"
		static_failed=1
	fi
}

# The manifest shape and the Claude hook wiring are checked by agents_render,
# which owns the manifest contract rather than restating it here.
check_render() {
	local subcommand="$1" label="$2" output
	if output="$("$REPO_ROOT/bin/agents_render" "$subcommand" 2>&1)"; then
		say OK "$label"
	else
		say BROKEN "$label"
		[[ -n "$output" ]] && printf '%s\n' "$output" >&2
		static_failed=1
	fi
}

# Every skill must be discoverable: a SKILL.md whose declared name matches the
# directory, because that directory name is the id each harness links against.
check_skill_sources() {
	local dir name skill_md
	for dir in "$REPO_ROOT"/agents/skills/*/; do
		[[ -d "$dir" ]] || continue
		name="$(basename "$dir")"
		skill_md="$dir/SKILL.md"
		if [[ ! -f "$skill_md" ]]; then
			say BROKEN "$name has no SKILL.md"
			static_failed=1
		elif grep -qxF "name: $name" "$skill_md" && grep -q '^description:' "$skill_md"; then
			say OK "$name SKILL.md frontmatter"
		else
			say BROKEN "$name SKILL.md frontmatter (needs 'name: $name' and a description)"
			static_failed=1
		fi
	done
}

# JSON validity is not restated here: the delegated agents_link --check covers
# Claude settings (jq) and Cursor hooks (byte-compare against the rendered
# form), and validate-manifest parses the manifest itself.
check_repo_link
check_render validate-manifest "portable hooks manifest is well-formed"
check_render check-claude-hooks "Claude settings run every portable hook"
check_skill_sources

if [[ "$static_failed" -ne 0 ]]; then
	verdict 1 'Static conformance: FAIL'
	exit 1
fi
verdict 2 'Static conformance: PASS'

if [[ "$LIVE" -eq 0 ]]; then
	exit 0
fi

RUN_CAPTURE_PY='import subprocess, sys
seconds, output, *command = sys.argv[1:]
try:
    result = subprocess.run(
        command,
        text=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=int(seconds),
        check=False,
    )
except subprocess.TimeoutExpired as exc:
    text = (exc.stdout or "") + "\nTIMEOUT\n"
    open(output, "w", encoding="utf-8").write(text)
    raise SystemExit(124)
open(output, "w", encoding="utf-8").write(result.stdout)
raise SystemExit(result.returncode)'

run_capture() {
	local title="$1" output="$2"
	shift 2
	if [[ "$USE_GUM" -eq 1 ]]; then
		gum spin --title "$title" -- python3 -c "$RUN_CAPTURE_PY" "$TIMEOUT_SECONDS" "$output" "$@"
	else
		python3 -c "$RUN_CAPTURE_PY" "$TIMEOUT_SECONDS" "$output" "$@"
	fi
}

matches_canary() {
	local output="$1" expected="$2"
	grep -qxF "$expected" "$output" || grep -qF "$expected" "$output"
}

is_auth_blocked() {
	grep -Eqi 'authentication required|token refresh failed|unauthorized|run .*login|401' "$1"
}

rule_status="" skill_status="" hook_status=""
rows=()
live_failed=0
live_blocked=0
marker="$(mktemp -t agents-conform-marker.XXXXXX)"
work="$(mktemp -d -t agents-conform.XXXXXX)"
trap 'rm -f "$marker"; rm -rf "$work"' EXIT

record() {
	rows+=("$1|$2|$3|$4|$5")
	if [[ "$2" == "FAIL" || "$3" == "FAIL" || "$4" == "FAIL" ]]; then
		live_failed=1
	fi
	if [[ "$2" == "BLOCKED" || "$3" == "BLOCKED" || "$4" == "BLOCKED" ]]; then
		live_blocked=1
	fi
}

check_rule() {
	local name="$1"
	shift
	local output="$work/${name}-rule.txt" retries=2
	: >"$marker"
	rule_status="FAIL"
	while ((retries-- > 0)); do
		if AGENTS_CONFORM_MARKER="$marker" run_capture "$name: rule canary" "$output" "$@" && matches_canary "$output" "AGENTS-OK 1"; then
			rule_status="PASS"
			break
		fi
		if is_auth_blocked "$output"; then
			rule_status="BLOCKED"
			break
		fi
	done
	if [[ -s "$marker" ]]; then hook_status="PASS"; else hook_status="N/A"; fi
}

# A skill opts into the live tier by publishing its own canary contract line;
# skills without one are still projected and checked statically, just not asked
# to prove discoverability with tokens.
canary_skills() {
	local skill_md name
	for skill_md in "$REPO_ROOT"/agents/skills/*/SKILL.md; do
		[[ -f "$skill_md" ]] || continue
		name="$(basename "$(dirname "$skill_md")")"
		grep -qF "SKILL-CHECK $name" "$skill_md" && printf '%s\n' "$name"
	done
}

# The prompt is appended here, so callers pass their harness command without
# one. last_message is for CLIs that report the final answer through a file
# instead of stdout; pass "" when stdout is authoritative.
check_one_skill() {
	local harness="$1" skill="$2" last_message="$3"
	shift 3
	local output="$work/${harness}-skill-${skill}.txt" retries=2
	local expected="SKILL-OK $skill 1"
	skill_status="FAIL"
	while ((retries-- > 0)); do
		if run_capture "$harness: $skill canary" "$output" "$@" "SKILL-CHECK $skill" &&
			matches_canary "$output" "$expected"; then
			skill_status="PASS"
			break
		fi
		if [[ -n "$last_message" ]] && [[ -f "$last_message" ]] && matches_canary "$last_message" "$expected"; then
			skill_status="PASS"
			break
		fi
		if is_auth_blocked "$output"; then
			skill_status="BLOCKED"
			break
		fi
	done
}

# One column covers every canary skill: PASS only if all of them pass, and
# BLOCKED wins over FAIL because an unauthenticated harness was never tested.
check_skills() {
	local harness="$1" last_message="$2"
	shift 2
	if [[ -z "$CANARY_SKILLS" ]]; then
		skill_status="N/A"
		return
	fi
	if [[ "$LIVE_SKILLS" -eq 0 ]]; then
		skill_status="SKIP"
		return
	fi
	local skill aggregate="PASS"
	for skill in $CANARY_SKILLS; do
		check_one_skill "$harness" "$skill" "$last_message" "$@"
		if [[ "$skill_status" == "BLOCKED" ]]; then
			aggregate="BLOCKED"
			break
		fi
		[[ "$skill_status" == "FAIL" ]] && aggregate="FAIL"
	done
	skill_status="$aggregate"
}

CANARY_SKILLS="$(canary_skills)"

echo
header 'Live conformance'

if command -v claude >/dev/null 2>&1; then
	check_rule claude claude -p --permission-mode dontAsk "CANARY-CHECK"
	claude_rule="$rule_status"; claude_hook="$hook_status"
	check_skills claude "" claude -p --permission-mode dontAsk
	record "Claude" "$claude_rule" "$skill_status" "$claude_hook" "global rules"
fi

if command -v codex >/dev/null 2>&1; then
	codex_last="$work/codex-last.txt"
	check_rule codex codex exec --ephemeral --sandbox read-only --output-last-message "$codex_last" "CANARY-CHECK"
	if [[ -f "$codex_last" ]] && matches_canary "$codex_last" "AGENTS-OK 1"; then rule_status="PASS"; fi
	codex_rule="$rule_status"
	codex_skill_last="$work/codex-skill-last.txt"
	check_skills codex "$codex_skill_last" codex exec --ephemeral --sandbox read-only --output-last-message "$codex_skill_last"
	record "Codex" "$codex_rule" "$skill_status" "N/A" "hook schema intentionally unmanaged"
fi

if command -v opencode >/dev/null 2>&1; then
	check_rule opencode opencode run --dir "$REPO_ROOT" "CANARY-CHECK"
	opencode_rule="$rule_status"
	check_skills opencode "" opencode run --dir "$REPO_ROOT"
	record "OpenCode" "$opencode_rule" "$skill_status" "N/A" "plugin hooks are not command-portable"
fi

cursor_cmd=""
if command -v cursor-agent >/dev/null 2>&1; then cursor_cmd="cursor-agent"; elif command -v agent >/dev/null 2>&1; then cursor_cmd="agent"; fi
if [[ -n "$cursor_cmd" ]]; then
	# --trust is required or Cursor refuses an unmarked workspace outright and
	# the canary reads as a rules failure. It is not persisted to the workspace,
	# and --mode ask keeps the run read-only.
	check_rule cursor "$cursor_cmd" -p --mode ask --trust --workspace "$REPO_ROOT" "CANARY-CHECK"
	cursor_rule="$rule_status"; cursor_hook="$hook_status"
	check_skills cursor "" "$cursor_cmd" -p --mode ask --trust --workspace "$REPO_ROOT"
	record "Cursor" "$cursor_rule" "$skill_status" "$cursor_hook" "global rule reaches projects under \$HOME only"
fi

if [[ "${#rows[@]}" -gt 0 ]]; then
	if [[ "$USE_GUM" -eq 1 ]]; then
		printf '%s\n' "${rows[@]}" | gum table --print --separator '|' --columns 'HARNESS,RULES,SKILL,HOOK,NOTES'
	else
		printf '%-10s %-7s %-7s %-7s %s\n' "HARNESS" "RULES" "SKILL" "HOOK" "NOTES"
		printf '%-10s %-7s %-7s %-7s %s\n' "-------" "-----" "-----" "----" "-----"
		for row in "${rows[@]}"; do
			IFS='|' read -r name rules skill hook note <<<"$row"
			printf '%-10s %-7s %-7s %-7s %s\n' "$name" "$rules" "$skill" "$hook" "$note"
		done
	fi
fi

if [[ "$live_failed" -ne 0 ]]; then
	verdict 1 'Live conformance: DRIFT DETECTED (informational)'
	if [[ "${AGENTS_LIVE_GATE:-0}" == "1" ]]; then exit 1; fi
elif [[ "$live_blocked" -ne 0 ]]; then
	verdict 3 'Live conformance: PASS FOR AUTHENTICATED HARNESSES; BLOCKED ROWS UNTESTED'
else
	verdict 2 'Live conformance: PASS'
fi
