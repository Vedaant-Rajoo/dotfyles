#!/usr/bin/env fish
# Taken from: https://github.com/joshmedeski/dotfiles/blob/main/.config/bin/u
#
# Whole-machine maintenance: Neovim plugins, Homebrew formulae, and casks. A
# cask whose app is running is gracefully quit (force-quit on request),
# upgraded, and reopened immediately. Lifecycle state lives in fish variables:
# the signal/exit handlers reopen anything still closed, and a hard kill at
# worst leaves an app to reopen from the Dock.

# The lifecycle helper ships beside this script, so resolve it relative to the
# file itself rather than trusting the caller's working directory or PATH.
# Symlinks resolve first, so a linked `u` still finds its own helper.
if not set -q U_LIFECYCLE_HELPER
    set -g U_LIFECYCLE_HELPER (dirname (path resolve (status filename)))/u-cask-lifecycle.js
end

# In-memory lifecycle state, tab-joined rows:
#   U_APPS     token, app path, bundle id, PIDs running at prepare time (CSV,
#              empty when the app was not running)
#   U_CLOSED   token, app path — closed by this run and not yet reopened
#   U_SKIPS    token, reason — deliberate decisions, one per token
#   U_FAILURES category, subject, detail — commands that did not do their job

function u_log
    printf '%s\n' $argv[2..-1] >>"$argv[1]"
end

function u_run_logged
    $argv[2..-1] >>"$argv[1]"
end

function u_run_brew_upgrade
    brew upgrade $argv[2..-1] 2>&1 | tee -a "$argv[1]"
    set -l upgrade_status $pipestatus[1]
    return $upgrade_status
end

function u_record_failure --argument-names category subject detail
    set -ga U_FAILURES "$category"\t"$subject"\t"$detail"
end

# A skip is a deliberate decision; the first recorded reason for a token wins.
function u_record_skip --argument-names token reason
    u_token_skipped "$token"; or set -ga U_SKIPS "$token"\t"$reason"
end

function u_token_skipped --argument-names requested_token
    for row in $U_SKIPS
        if test (string split \t -- $row)[1] = "$requested_token"
            return 0
        end
    end
    return 1
end

function u_token_has_failure --argument-names requested_token
    for row in $U_FAILURES
        if test (string split \t -- $row)[2] = "$requested_token"
            return 0
        end
    end
    return 1
end

function u_record_closed --argument-names token app_path
    set -l row "$token"\t"$app_path"
    contains -- $row $U_CLOSED; or set -ga U_CLOSED $row
end

# The JSON document arrives as every argument, because callers pass an unquoted
# fish command substitution and fish splits that into one argument per line.
function u_outdated_names --argument-names kind
    printf '%s\n' $argv[2..-1] | jq -r --arg kind "$kind" '
        .[$kind] // []
        | if type == "array" then
              .
          else
              "u_outdated_names: \($kind) is not an array\n" | halt_error(1)
          end
        | .[] | .name // ""
        | if type == "string" and length > 0 then
              .
          else
              "u_outdated_names: outdated record has no name\n" | halt_error(1)
          end
    '
end

# Emits one app artifact target per line for one token of a batched
# `brew info --cask --json=v2` document.
function u_cask_app_paths --argument-names token
    printf '%s\n' $argv[2..-1] | jq -r --arg token "$token" '
        .casks // [] | .[] | select(.token == $token) | .artifacts // [] | .[]
        | select(type == "object" and has("app"))
        | .target // ""
        | if type == "string" and startswith("/") then
              .
          else
              "u_cask_app_paths: app artifact has no absolute target path\n" | halt_error(1)
          end
    '
end

# Emits one `path<TAB>bundle_id<TAB>pids_csv` record for an installed bundle.
function u_inspect_app --argument-names bundle_path
    if test -z "$bundle_path"
        echo 'u_inspect_app: an app bundle path is required' >&2
        return 1
    end

    if not test -e "$U_LIFECYCLE_HELPER"
        echo "u_inspect_app: lifecycle helper is missing: $U_LIFECYCLE_HELPER" >&2
        return 1
    end

    set -l inspect_json (osascript -l JavaScript "$U_LIFECYCLE_HELPER" inspect "$bundle_path")
    or return 1

    printf '%s\n' $inspect_json | jq -r '[.path, .bundleId, (.pids | map(tostring) | join(","))] | @tsv'
end

# Runs one helper operation against exact PIDs and emits the PIDs (CSV) that
# still identify live instances of the bundle.
function u_lifecycle_operation --argument-names command bundle_id
    set -l output (osascript -l JavaScript "$U_LIFECYCLE_HELPER" "$command" "$bundle_id" $argv[3..-1])
    or return $status

    printf '%s\n' $output | jq -r '.pids | map(tostring) | join(",")'
end

# Records one U_APPS row per app artifact of one outdated cask. Reads the
# batched brew info document from $argv.
function u_prepare_cask --argument-names token
    set -l app_paths (u_cask_app_paths "$token" $argv[2..-1])
    or begin
        u_record_failure cask-artifacts "$token" 'unusable app artifact metadata'
        u_record_skip "$token" 'unusable app artifact metadata'
        return 1
    end

    for app_path in $app_paths
        set -l record (u_inspect_app "$app_path")
        or begin
            u_record_failure app-inspect "$token" "unable to inspect $app_path"
            u_record_skip "$token" "unable to inspect $app_path"
            return 1
        end

        set -ga U_APPS "$token"\t"$record"
    end
end

# Asks once, for every running application across every prepared cask. Return 0
# when closing was approved or nothing is running, 2 for a deliberate decline.
function u_confirm_running_apps
    set -l descriptions
    set -l running_tokens

    for row in $U_APPS
        set -l fields (string split \t -- $row)
        if test -z "$fields[4]"
            continue
        end

        set -l display (string replace -r '\.app$' '' -- (basename "$fields[2]"))
        set -l description "$display ($fields[1])"

        contains -- "$description" $descriptions; or set -a descriptions "$description"
        contains -- "$fields[1]" $running_tokens; or set -a running_tokens "$fields[1]"
    end

    if test (count $running_tokens) -eq 0
        return 0
    end

    echo 'These applications are running and their casks are outdated:'
    printf '  - %s\n' $descriptions

    if gum confirm 'Close these applications so their casks can upgrade?'
        return 0
    end

    for token in $running_tokens
        u_record_skip "$token" 'declined closing running applications'
    end
    return 2
end

# Terminates one app's exact original PIDs and polls until none identifies a
# live instance. The helper returns when termination is delivered, not when the
# process is reaped. Return 0 when the app stopped (recording it as closed),
# 2 when instances survived every poll, and 1 when the poll cannot be trusted.
function u_stop_app --argument-names operation token app_path bundle_id pids_csv
    set -l original_pids (string split , -- "$pids_csv")

    u_lifecycle_operation $operation "$bundle_id" $original_pids >/dev/null
    or u_record_failure app-$operation "$token" "$operation helper failed for $app_path"

    for attempt in (seq 10)
        sleep 1
        set -l running_csv (u_lifecycle_operation running "$bundle_id" $original_pids)
        or begin
            u_record_failure app-running "$token" "unable to reconcile $app_path after $operation"
            u_record_skip "$token" 'unable to determine whether an application stopped'
            return 1
        end

        if test -z "$running_csv"
            u_record_closed "$token" "$app_path"
            return 0
        end
    end

    return 2
end

# Stops every initially running app artifact for one cask token. Any artifact
# left running makes the whole token ineligible, while already closed artifacts
# stay recorded so they are reopened. Return 2 only for a deliberate
# force-confirmation decline and 1 for an operational lifecycle failure.
function u_stop_cask_apps --argument-names requested_token
    for row in $U_APPS
        set -l fields (string split \t -- $row)
        if test "$fields[1]" != "$requested_token"; or test -z "$fields[4]"
            continue
        end

        u_stop_app terminate "$fields[1]" "$fields[2]" "$fields[3]" "$fields[4]"
        set -l stop_status $status
        if test $stop_status -eq 0
            continue
        end
        if test $stop_status -ne 2
            return 1
        end

        set -l display (string replace -r '\.app$' '' -- (basename "$fields[2]"))
        if not gum confirm "Force quit $display so $requested_token can upgrade?"
            u_record_skip "$requested_token" 'application remained running after force termination was declined'
            return 2
        end

        u_stop_app force-terminate "$fields[1]" "$fields[2]" "$fields[3]" "$fields[4]"
        set -l force_status $status
        if test $force_status -eq 0
            continue
        end
        if test $force_status -eq 2
            u_record_failure app-force-terminate "$requested_token" "application remained running after force termination: $fields[2]"
            u_record_skip "$requested_token" 'application remained running after force termination'
        end
        return 1
    end
    return 0
end

# Exact-PID closure only proves the instances inventoried at prepare time
# stopped. An instance that relaunched — or first launched — after that proof
# would have its bundle replaced underneath it by `brew upgrade --cask`, so
# re-inspect every app artifact immediately before the upgrade. An instance
# alive now was never part of the confirmed stop decision: skip (2) rather than
# kill. Return 1 when the recheck itself cannot be trusted.
function u_recheck_cask_apps --argument-names requested_token
    for row in $U_APPS
        set -l fields (string split \t -- $row)
        if test "$fields[1]" != "$requested_token"
            continue
        end

        set -l record (u_inspect_app "$fields[2]")
        or begin
            u_record_failure app-inspect "$requested_token" "unable to re-inspect $fields[2] before upgrade"
            u_record_skip "$requested_token" 'unable to verify no application instance remains before upgrade'
            return 1
        end

        set -l inspected (string split \t -- "$record")
        if test -n "$inspected[3]"
            u_record_skip "$requested_token" "an application instance appeared before upgrade: $fields[2]"
            return 2
        end
    end
    return 0
end

# Reopens closed apps — every row, or only one token's. `open` on an already
# running app merely activates it, so the per-cask pass, the final sweep, and
# the signal/exit handlers can all run this without coordination. A failed open
# keeps its row so a later pass retries it.
function u_reopen_closed --argument-names requested_token
    set -l reopen_status 0
    set -l remaining

    for row in $U_CLOSED
        set -l fields (string split \t -- $row)
        if test -n "$requested_token"; and test "$fields[1]" != "$requested_token"
            set -a remaining $row
            continue
        end

        if open "$fields[2]"
            continue
        end

        u_record_failure app-reopen "$fields[1]" "unable to reopen $fields[2]"
        set -a remaining $row
        set reopen_status 1
    end

    set -g U_CLOSED $remaining
    return $reopen_status
end

function u_cleanup_on_exit --on-event fish_exit
    set -l exit_status $status
    u_reopen_closed
    return $exit_status
end

function u_cleanup_on_sigint --on-signal SIGINT
    u_reopen_closed
    exit 130
end

function u_cleanup_on_sigterm --on-signal SIGTERM
    u_reopen_closed
    exit 143
end

function u_report_cask_group --argument-names log_file label
    set -l tokens $argv[3..-1]
    set -l names none
    if test (count $tokens) -gt 0
        set names (string join ', ' -- $tokens)
    end

    set -l message "$label casks ("(count $tokens)"): $names"
    echo "$message"
    u_log "$log_file" "$message"
end

function u_report_lifecycle_details --argument-names log_file
    if test (count $U_SKIPS) -gt 0
        echo 'Skip details:'
        u_log "$log_file" 'Skip details:'
        for row in $U_SKIPS
            set -l fields (string split \t -- $row)
            set -l message "  - $fields[1]: $fields[2]"
            echo "$message"
            u_log "$log_file" "$message"
        end
    end

    if test (count $U_FAILURES) -gt 0
        echo 'Failure details:'
        u_log "$log_file" 'Failure details:'
        for row in $U_FAILURES
            set -l fields (string split \t -- $row)
            set -l message "  - $fields[2] [$fields[1]]: $fields[3]"
            echo "$message"
            u_log "$log_file" "$message"
        end
    end
end

# Stops, upgrades, and restores one cask without preventing later casks from
# running. Return 0 for a complete upgrade, 2 for a deliberate skip, and 1 for
# an upgrade or required lifecycle failure. A failure recorded during the stop
# flow fails the cask even when its apps stopped: the lifecycle cannot be
# trusted, and the apps are reopened instead of upgraded underneath.
function u_upgrade_cask --argument-names log_file token
    u_stop_cask_apps "$token"
    set -l stop_status $status
    if test $stop_status -ne 0; or u_token_has_failure "$token"
        u_reopen_closed "$token"
        set -l reopen_status $status
        if test $stop_status -eq 2; and test $reopen_status -eq 0; and not u_token_has_failure "$token"
            return 2
        end
        return 1
    end

    u_recheck_cask_apps "$token"
    set -l recheck_status $status
    if test $recheck_status -ne 0
        u_reopen_closed "$token"
        set -l reopen_status $status
        if test $recheck_status -eq 2; and test $reopen_status -eq 0
            return 2
        end
        return 1
    end

    u_run_brew_upgrade "$log_file" --cask "$token"
    set -l upgrade_status $status
    if test $upgrade_status -ne 0
        u_record_failure cask-upgrade "$token" "brew upgrade --cask failed with status $upgrade_status"
    end

    u_reopen_closed "$token"
    set -l reopen_status $status

    if test $upgrade_status -ne 0; or test $reopen_status -ne 0
        return 1
    end
    return 0
end

function u_main
    set -g U_APPS
    set -g U_CLOSED
    set -g U_SKIPS
    set -g U_FAILURES

    gum style \
        --foreground 12 --border-foreground 12 --border double \
        --margin "1 0" --padding "0 2" \
        '
██╗   ██╗██████╗ ██████╗  █████╗ ████████╗███████╗
██║   ██║██╔══██╗██╔══██╗██╔══██╗╚══██╔══╝██╔════╝
██║   ██║██████╔╝██║  ██║███████║   ██║   █████╗
██║   ██║██╔═══╝ ██║  ██║██╔══██║   ██║   ██╔══╝
╚██████╔╝██║     ██████╔╝██║  ██║   ██║   ███████╗
 ╚═════╝ ╚═╝     ╚═════╝ ╚═╝  ╚═╝   ╚═╝   ╚══════╝
 '

    set -l NOW (date +%Y-%m-%d-%H-%M-%S)
    set -l log_file /tmp/u-$NOW.txt
    u_log "$log_file" "$NOW" ""

    if not gum confirm "Do you wish to update your scripts?"
        exit 1
    end

    u_run_logged "$log_file" gum spin --spinner globe --title "💤 nvim maintaining (lazy, mason, treesitter)..." -- nvim --headless "+Lazy! sync" "+MasonUpdate" "+TSUpdate" +qa; or exit $status
    u_log "$log_file" ""
    echo "✅ 💤 nvim maintained (lazy, mason, treesitter)"

    u_run_logged "$log_file" gum spin --spinner globe --title "🍻 brew updating" --show-output -- brew update; or exit $status
    u_log "$log_file" ""
    echo "✅ 🍻 brew updated"

    set -l outdated_json (brew outdated --json=v2)
    set -l outdated_status $status
    if test $outdated_status -ne 0
        return $outdated_status
    end
    u_log "$log_file" "$outdated_json"

    set -l formulae (u_outdated_names formulae $outdated_json)
    set -l formulae_status $status
    if test $formulae_status -ne 0
        return $formulae_status
    end

    set -l casks (u_outdated_names casks $outdated_json)
    set -l casks_status $status
    if test $casks_status -ne 0
        return $casks_status
    end

    set -l upgraded_casks
    set -l skipped_casks
    set -l failed_casks
    set -l final_status 0

    if test (count $formulae) -eq 0; and test (count $casks) -eq 0
        u_log "$log_file" "No outdated brew packages"
    else
        # no spinner here: upgrades can prompt for sudo, and gum spin swallows the prompt
        echo "🍻 brew upgrading..."

        # Formulae are one fail-fast phase. No application has been stopped yet.
        if test (count $formulae) -gt 0
            u_run_brew_upgrade "$log_file" --formula $formulae
            set -l formula_status $status
            if test $formula_status -ne 0
                return $formula_status
            end
        end

        if test (count $casks) -gt 0
            # One batched metadata call for every outdated cask. Tokens come
            # straight from brew outdated, so brew failing here means no cask
            # has trustworthy app metadata.
            set -l cask_json (brew info --cask --json=v2 $casks)
            set -l info_status $status
            if test $info_status -ne 0
                u_record_failure cask-metadata all 'brew info --cask --json=v2 failed'
                set failed_casks $casks
            else
                for token in $casks
                    if not u_prepare_cask "$token" $cask_json
                        contains -- "$token" $failed_casks; or set -a failed_casks "$token"
                    end
                end
                u_confirm_running_apps
            end

            for token in $casks
                if contains -- "$token" $failed_casks
                    continue
                end
                if u_token_skipped "$token"
                    contains -- "$token" $skipped_casks; or set -a skipped_casks "$token"
                    continue
                end

                u_upgrade_cask "$log_file" "$token"
                set -l cask_status $status
                switch $cask_status
                    case 0
                        set -a upgraded_casks "$token"
                    case 2
                        contains -- "$token" $skipped_casks; or set -a skipped_casks "$token"
                    case '*'
                        contains -- "$token" $failed_casks; or set -a failed_casks "$token"
                end
            end
        end

        u_log "$log_file" ""
        if test (count $failed_casks) -gt 0
            set -l phase_message '⚠️ 🍻 brew upgrade phase completed with failures'
            echo "$phase_message"
            u_log "$log_file" "$phase_message"
        else if test (count $skipped_casks) -gt 0
            set -l phase_message '🍻 brew upgrade phase completed with skipped casks'
            echo "$phase_message"
            u_log "$log_file" "$phase_message"
        else
            echo "✅ 🍻 brew upgraded"
        end

        u_reopen_closed
        if test $status -ne 0
            u_record_failure lifecycle-cleanup all 'unable to restore every tracked application'
            set final_status 1
        end

        u_run_logged "$log_file" gum spin --spinner globe --title "🍻 brew cleaning up" --show-output -- brew cleanup --prune=all
        if test $status -eq 0
            u_log "$log_file" ""
            echo "✅ 🍻 brew cleaned up"
        else
            u_record_failure brew-cleanup all 'brew cleanup --prune=all failed'
            set final_status 1
        end
    end

    u_run_logged "$log_file" gum spin --spinner globe --title "🍻 brew doctoring" --show-output -- brew doctor
    if test $status -eq 0
        u_log "$log_file" ""
        echo "✅ 🍻 brew doctored"
    else
        u_record_failure brew-doctor all 'brew doctor failed'
        set final_status 1
    end

    if test (count $casks) -gt 0
        set -l summary "Cask summary: "(count $upgraded_casks)" upgraded, "(count $skipped_casks)" skipped, "(count $failed_casks)" failed"
        echo "$summary"
        u_log "$log_file" "$summary"
        u_report_cask_group "$log_file" Upgraded $upgraded_casks
        u_report_cask_group "$log_file" Skipped $skipped_casks
        u_report_cask_group "$log_file" Failed $failed_casks
    end

    u_report_lifecycle_details "$log_file"

    if test (count $failed_casks) -gt 0; or test (count $U_FAILURES) -gt 0
        set final_status 1
    end

    echo "✅ 🧾 logged to $log_file"
    bat "$log_file"

    return $final_status
end

if not set -q U_TEST_MODE
    u_main $argv
end
