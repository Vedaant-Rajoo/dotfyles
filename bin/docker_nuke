#!/usr/bin/env fish
# Stop and remove every Docker container, volume, and image on this machine.
# Pretty output and a confirm gate only when run interactively with gum
# available; piped or scripted runs keep the original plain behavior.

set -g use_gum 0
if command -q gum; and isatty stdout; and isatty stdin
    set -g use_gum 1
end

if test $use_gum -eq 1
    if not gum confirm "Delete ALL Docker containers, volumes, and images?"
        echo "docker_nuke: aborted"
        exit 1
    end
end

function run_step --argument-names title
    if test $use_gum -eq 1
        gum spin --title "$title" --show-error -- $argv[2..]
    else
        $argv[2..]
    end
end

set -l failed 0
set -l containers (docker ps -a -q); or set failed 1

if test (count $containers) -gt 0
    run_step "Stopping "(count $containers)" containers" docker stop $containers; or set failed 1
    run_step "Removing "(count $containers)" containers" docker rm $containers; or set failed 1
end

set -l volumes (docker volume ls -q); or set failed 1

if test (count $volumes) -gt 0
    run_step "Removing "(count $volumes)" volumes" docker volume rm $volumes; or set failed 1
end

set -l images (docker image ls -q); or set failed 1

if test (count $images) -gt 0
    run_step "Removing "(count $images)" images" docker rmi $images; or set failed 1
end

if test $use_gum -eq 1
    if test $failed -eq 0
        gum style --bold --foreground 2 "Docker state cleared"
    else
        gum style --bold --foreground 1 "docker_nuke: some steps failed"
    end
end

exit $failed
