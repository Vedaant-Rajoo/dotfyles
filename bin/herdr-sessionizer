#!/usr/bin/env bash
# herdr-sessionizer — fuzzy-find a project dir and open/focus a Herdr workspace.
# The tmux→Herdr cutover replacement for tmux-sessionizer (workspaces ≈ sessions).
# Launch surfaces: Fish Ctrl-o, Ghostty cmd+s, prefix+f inside Herdr, or direct CLI.

set -euo pipefail

SEARCH_PATHS=(
	"$HOME/Development"
	"$HOME/dev"
	"$HOME/projects"
	"$HOME/.config"
)
DEFAULT_DEPTH=2

# Seconds to wait for a freshly-spawned server to report running.
START_TIMEOUT="${HERDR_SESSIONIZER_START_TIMEOUT:-5}"

die() {
	echo "herdr-sessionizer: $*" >&2
	exit 1
}

# --- Preflight -------------------------------------------------------------
# Resolve herdr (HERDR_BIN_PATH wins) and hard-fail on any missing dependency.
herdr_bin="${HERDR_BIN_PATH:-$(command -v herdr || true)}"
if [[ -z "$herdr_bin" || ! -x "$herdr_bin" ]]; then
	echo "herdr-sessionizer: 'herdr' not found on PATH (set HERDR_BIN_PATH to override)" >&2
	exit 127
fi

# fzf + jq are required; fd is optional (find fallback below).
missing=()
for tool in fzf jq; do
	command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
done
if [[ ${#missing[@]} -gt 0 ]]; then
	echo "herdr-sessionizer: missing required tool(s): ${missing[*]}" >&2
	echo "  install them and retry (required: herdr, fzf, jq; optional: fd)" >&2
	exit 127
fi

# --- Herdr helpers ---------------------------------------------------------
# Herdr is Rust: NEVER pipe its CLI output into grep -q / head — an early pipe
# close can SIGPIPE and panic it. Always capture full output, then parse with jq.
server_running() {
	local out
	out="$("$herdr_bin" status server 2>/dev/null || true)"
	[[ "$out" == *'status: running'* ]]
}

ensure_server() {
	if server_running; then
		return 0
	fi
	nohup "$herdr_bin" server >/dev/null 2>&1 &
	local deadline=$(( SECONDS + START_TIMEOUT ))
	while (( SECONDS < deadline )); do
		if server_running; then
			return 0
		fi
		sleep 0.1
	done
	die "herdr server did not come up within ${START_TIMEOUT}s; try 'herdr status' and check herdr-server.log"
}

workspace_list_json() {
	"$herdr_bin" workspace list 2>/dev/null
}

pane_list_json() {
	"$herdr_bin" pane list 2>/dev/null
}

find_dirs() {
	# Existing workspaces first (label\tid), then project dirs.
	if server_running; then
		local list
		list="$(workspace_list_json || true)"
		if [[ -n "$list" ]]; then
			jq -r '
				.result.workspaces[]?
				| "\(.label)\tworkspace:\(.workspace_id)"
			' <<<"$list" 2>/dev/null || true
		fi
	fi

	local entry path depth
	for entry in "${SEARCH_PATHS[@]}"; do
		path="$entry"
		depth="$DEFAULT_DEPTH"
		if [[ "$entry" == *:* ]]; then
			path="${entry%:*}"
			depth="${entry##*:}"
		fi
		[[ -d "$path" ]] || continue
		if command -v fd &>/dev/null; then
			fd . "$path" --min-depth 1 --max-depth "$depth" --type d \
				--exclude .git --exclude node_modules
		else
			find "$path" -mindepth 1 -maxdepth "$depth" \
				\( -name .git -o -name node_modules \) -prune -o -type d -print
		fi
	done
}

resolve_dir() {
	( cd "$1" 2>/dev/null && pwd -P )
}

# First workspace id whose pane cwd/foreground_cwd matches $1 (jq first(): no head → no SIGPIPE).
workspace_id_for_cwd() {
	local dir="$1" list
	list="$(pane_list_json || true)"
	[[ -n "$list" ]] || return 0
	jq -r --arg d "$dir" '
		first(
			.result.panes[]?
			| select(.cwd == $d or .foreground_cwd == $d)
			| .workspace_id
		) // empty
	' <<<"$list" 2>/dev/null || true
}

# First workspace id whose label matches $1.
workspace_id_for_label() {
	local label="$1" list
	list="$(workspace_list_json || true)"
	[[ -n "$list" ]] || return 0
	jq -r --arg l "$label" '
		first(
			.result.workspaces[]?
			| select(.label == $l)
			| .workspace_id
		) // empty
	' <<<"$list" 2>/dev/null || true
}

focus_workspace() {
	local id="$1"
	"$herdr_bin" workspace focus "$id" >/dev/null
}

create_workspace() {
	local dir="$1" label="$2"
	"$herdr_bin" workspace create --cwd "$dir" --label "$label" --focus >/dev/null
}

maybe_attach() {
	# Already inside a Herdr client — focus is enough.
	[[ -n "${HERDR_ENV:-}" ]] && return 0
	# Temp sessionizer pane inside Herdr — don't nest another client.
	[[ -n "${HERDR_SOCKET_PATH:-}" && -n "${HERDR_ACTIVE_PANE_ID:-}" ]] && return 0
	# Non-interactive callers (scripts, tests) should not try to open the TUI.
	[[ -t 0 && -t 1 ]] || return 0
	exec "$herdr_bin"
}

# --- Main ------------------------------------------------------------------
ensure_server

if [[ $# -eq 1 ]]; then
	selected="$1"
else
	selected="$(
		find_dirs | fzf --prompt='  ' --height=40% --reverse --border --delimiter=$'\t' --with-nth=1 || true
	)"
fi

# fzf cancelled / empty selection → soft exit.
[[ -z "${selected:-}" ]] && exit 0

# Existing workspace row from fzf: "label<TAB>workspace:ID"
if [[ "$selected" == *$'\t'workspace:* ]]; then
	ws_id="${selected##*$'\t'workspace:}"
	focus_workspace "$ws_id"
	maybe_attach
	exit 0
fi

# Path → focus an existing workspace (matched by cwd, then label) else create.
if [[ "$selected" == */* ]]; then
	start_dir="$(resolve_dir "$selected" || true)"
	[[ -n "$start_dir" ]] || die "cannot resolve directory '$selected'"
	selected_name="$(basename "$start_dir" | tr ' .:' '___')"

	existing="$(workspace_id_for_cwd "$start_dir" || true)"
	if [[ -z "$existing" ]]; then
		existing="$(workspace_id_for_label "$selected_name" || true)"
	fi

	if [[ -n "$existing" ]]; then
		focus_workspace "$existing"
	else
		create_workspace "$start_dir" "$selected_name"
	fi
	maybe_attach
	exit 0
fi

# Bare label (CLI arg or legacy): focus by label if present.
ws_id="$(workspace_id_for_label "$selected" || true)"
if [[ -n "$ws_id" ]]; then
	focus_workspace "$ws_id"
	maybe_attach
	exit 0
fi

die "no herdr workspace named '$selected'"
