#!/usr/bin/env bash
# herdr-sessionizer — fuzzy-find a project dir and open/focus a Herdr workspace.
# Launch surfaces: Fish Ctrl-o, Ghostty cmd+s, prefix+f inside Herdr, or direct CLI.

# shellcheck disable=SC2016 # single-quoted $v is a jq variable, not a shell one
set -euo pipefail

SEARCH_PATHS=("$HOME/dev" "$HOME/.config")
SEARCH_DEPTH=2

# Seconds to wait for a freshly-spawned server to report running.
START_TIMEOUT=5

die() {
	echo "herdr-sessionizer: $*" >&2
	exit 1
}

# --- Preflight: all four come from the Brewfile. ----------------------------
for tool in herdr fzf jq fd; do
	command -v "$tool" >/dev/null 2>&1 || { echo "herdr-sessionizer: missing required tool: $tool" >&2; exit 127; }
done
herdr_bin="$(command -v herdr)"

# --- Herdr helpers ---------------------------------------------------------
# Herdr is Rust: NEVER pipe its CLI output into grep -q / head — an early pipe
# close can SIGPIPE and panic it. Always capture full output, then parse with jq.
server_running() {
	local out
	out="$("$herdr_bin" status server 2>/dev/null || true)"
	[[ "$out" == *'status: running'* ]]
}

# A server that outlives the terminal app which spawned it keeps running with a
# dead Mach bootstrap port, and every pane it spawns inherits the corpse. In
# such a pane getpwuid() returns NULL, so sudo says "you do not exist in the
# passwd database" and fish warns that notify_register_file_descriptor() failed
# with status 9. Cheap probe: with no bootstrap port there is no opendirectoryd
# to ask, so `id -un` falls back to printing the raw uid.
bootstrap_port_alive() {
	[[ "$(id -un 2>/dev/null)" != "$(id -u)" ]]
}

warn_dead_bootstrap_port() {
	echo "herdr-sessionizer: no Mach bootstrap port in this process." >&2
	echo "  The herdr server outlived the terminal app that started it." >&2
	echo "  sudo, dscl and fish universal variables misbehave in every pane it spawns." >&2
	echo "  Fix: brew services restart herdr" >&2
}

ensure_server() {
	if server_running; then
		# Inside a pane our own namespace *is* the server's namespace, so this
		# probe reports on the running server. Warn only — restarting here
		# would kill whatever the panes are running.
		if [[ -n "${HERDR_ENV:-}${HERDR_PANE_ID:-}" ]] && ! bootstrap_port_alive; then
			warn_dead_bootstrap_port
		fi
		return 0
	fi
	# Never hand a dead bootstrap port to a brand-new server: it would poison
	# every pane for the whole life of that server.
	if ! bootstrap_port_alive; then
		warn_dead_bootstrap_port
		die "refusing to start a herdr server without a bootstrap port; start it from a fresh terminal window or with 'brew services start herdr'"
	fi
	nohup "$herdr_bin" server >/dev/null 2>&1 &
	local deadline=$(( SECONDS + START_TIMEOUT ))
	while (( SECONDS < deadline )); do
		if server_running; then
			return 0
		fi
		sleep 0.1
	done
	die "herdr server did not come up within ${START_TIMEOUT}s; try 'herdr status' and check herdr-server.log"
}

find_dirs() {
	# Existing workspaces first (label\tid), then project dirs. ensure_server
	# has already run, so the server is up.
	local list
	list="$("$herdr_bin" workspace list 2>/dev/null || true)"
	jq -r '.result.workspaces[]? | "\(.label)\tworkspace:\(.workspace_id)"' <<<"$list" 2>/dev/null || true

	local path
	for path in "${SEARCH_PATHS[@]}"; do
		[[ -d "$path" ]] || continue
		fd . "$path" --min-depth 1 --max-depth "$SEARCH_DEPTH" --type d \
			--exclude .git --exclude node_modules
	done
}

# First workspace id from `herdr $1 list` whose entry matches jq condition $2,
# with $v bound to $3 (jq first(): no head, so no SIGPIPE).
workspace_id() {
	local list
	list="$("$herdr_bin" "$1" list 2>/dev/null || true)"
	[[ -n "$list" ]] || return 0
	jq -r --arg v "$3" "first(.result.${1}s[]? | select($2) | .workspace_id) // empty" <<<"$list" 2>/dev/null || true
}

maybe_attach() {
	# Already inside a Herdr client — focus is enough.
	[[ -n "${HERDR_ENV:-}" ]] && return 0
	# Temp sessionizer pane inside Herdr — don't nest another client.
	[[ -n "${HERDR_SOCKET_PATH:-}" && -n "${HERDR_ACTIVE_PANE_ID:-}" ]] && return 0
	# Non-interactive callers (scripts, tests) should not try to open the TUI.
	[[ -t 0 && -t 1 ]] || return 0
	exec "$herdr_bin"
}

# --- Main ------------------------------------------------------------------
ensure_server

if [[ $# -eq 1 ]]; then
	selected="$1"
else
	selected="$(
		find_dirs | fzf --prompt='  ' --height=40% --reverse --border --delimiter=$'\t' --with-nth=1 || true
	)"
fi

# fzf cancelled / empty selection → soft exit.
[[ -z "${selected:-}" ]] && exit 0

# Existing workspace row from fzf: "label<TAB>workspace:ID"
if [[ "$selected" == *$'\t'workspace:* ]]; then
	"$herdr_bin" workspace focus "${selected##*$'\t'workspace:}" >/dev/null
	maybe_attach
	exit 0
fi

# Path → focus an existing workspace (matched by cwd, then label) else create.
if [[ "$selected" == */* ]]; then
	start_dir="$(cd "$selected" 2>/dev/null && pwd -P || true)"
	[[ -n "$start_dir" ]] || die "cannot resolve directory '$selected'"
	selected_name="$(basename "$start_dir" | tr ' .:' '___')"

	existing="$(workspace_id pane '.cwd == $v or .foreground_cwd == $v' "$start_dir")"
	[[ -n "$existing" ]] || existing="$(workspace_id workspace '.label == $v' "$selected_name")"

	if [[ -n "$existing" ]]; then
		"$herdr_bin" workspace focus "$existing" >/dev/null
	else
		"$herdr_bin" workspace create --cwd "$start_dir" --label "$selected_name" --focus >/dev/null
	fi
	maybe_attach
	exit 0
fi

# Bare label (CLI arg or legacy): focus by label if present.
ws_id="$(workspace_id workspace '.label == $v' "$selected")"
if [[ -n "$ws_id" ]]; then
	"$herdr_bin" workspace focus "$ws_id" >/dev/null
	maybe_attach
	exit 0
fi

die "no herdr workspace named '$selected'"
