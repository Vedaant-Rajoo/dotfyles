#!/usr/bin/env bash
# Project the canonical agents/ rules, skills, and portable hooks into each
# installed AI harness without taking ownership of provider, auth, or UI config.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
AGENTS_ROOT="$REPO_ROOT/agents"
CHECK=0
TARGET="all"

# Pretty output through gum only when interactive; pipes and logs get the
# plain deterministic format.
USE_GUM=0
if command -v gum >/dev/null 2>&1 && [[ -t 1 ]]; then
	USE_GUM=1
fi

usage() {
	cat <<'EOF'
usage: agents_link [--check] [all|claude|codex|opencode|cursor]

  --check  Report drift without changing files.

Rules and skills come from ~/.config/agents. Harness-native settings remain in
that harness's own config; adapters only add links and generated hook shims.
EOF
}

for arg in "$@"; do
	case "$arg" in
	--check) CHECK=1 ;;
	all | claude | codex | opencode | cursor) TARGET="$arg" ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 1
		;;
	esac
done

failed=0

say() {
	local status="$1"
	shift
	if [[ "$USE_GUM" -eq 0 ]]; then
		printf '%-8s%s\n' "$status" "$*"
		return
	fi
	local color=7
	case "$status" in
	OK | ok: | linked: | wrote:) color=2 ;;
	STALE | relink: | backup:) color=3 ;;
	BROKEN | MISSING | error:) color=1 ;;
	SKIP | INFO) color=4 ;;
	esac
	printf '%s%s\n' "$(CLICOLOR_FORCE=1 gum style --bold --foreground "$color" "$(printf '%-8s' "$status")")" "$*"
}

is_same_link() {
	local live="$1" source="$2"
	[[ -L "$live" ]] && [[ "$live" -ef "$source" ]]
}

check_link() {
	local live="$1" source="$2" label="$3"
	if is_same_link "$live" "$source"; then
		say OK "$label"
		return 0
	fi
	if [[ -L "$live" ]]; then
		say STALE "$label (points to $(readlink "$live"))"
	elif [[ -e "$live" ]]; then
		say BROKEN "$label (not a symlink)"
	else
		say MISSING "$label"
	fi
	return 1
}

link_one() {
	local live="$1" source="$2" label="$3"
	mkdir -p "$(dirname "$live")"
	if is_same_link "$live" "$source"; then
		say 'ok:' "$label already linked"
		return 0
	fi
	if [[ -L "$live" ]]; then
		say 'relink:' "$label (was $(readlink "$live"))"
		rm "$live"
	elif [[ -e "$live" ]]; then
		local backup="${live}.pre-agents-link-backup"
		if [[ -e "$backup" ]]; then
			say 'error:' "$label exists and backup already exists at $backup" >&2
			return 1
		fi
		say 'backup:' "$label -> $backup"
		mv "$live" "$backup"
	fi
	ln -s "$source" "$live"
	say 'linked:' "$label -> $source"
}

project_link() {
	if [[ "$CHECK" -eq 1 ]]; then
		check_link "$1" "$2" "$3" || failed=1
	else
		link_one "$1" "$2" "$3" || failed=1
	fi
}

project_skills() {
	local root="$1" harness="$2" skill source live
	if [[ "$CHECK" -eq 1 ]]; then
		if [[ ! -d "$root" ]]; then
			say MISSING "$harness skills root ($root)"
			failed=1
			return
		fi
	else
		mkdir -p "$root"
	fi
	for source in "$AGENTS_ROOT"/skills/*; do
		[[ -d "$source" ]] || continue
		skill="$(basename "$source")"
		live="$root/$skill"
		project_link "$live" "$source" "$harness skill: $skill"
	done
}

write_cursor_hooks() {
	local live="$HOME/.cursor/hooks.json"
	local command="$AGENTS_ROOT/hooks/scripts/conformance-stop-marker.sh"
	local expected
	expected="$(python3 - "$command" <<'PY'
import json, sys
print(json.dumps({
    "version": 1,
    "hooks": {"stop": [{"command": sys.argv[1]}]},
}, indent=2) + "\n", end="")
PY
)"
	if [[ "$CHECK" -eq 1 ]]; then
		if [[ -f "$live" ]] && [[ "$(<"$live")" == "$expected" ]]; then
			say OK "Cursor portable hooks"
		else
			say STALE "Cursor portable hooks"
			failed=1
		fi
		return
	fi
	if [[ -e "$live" ]] && [[ ! -f "$live" ]]; then
		say 'error:' "Cursor hooks path is not a regular file: $live" >&2
		failed=1
		return
	fi
	if [[ -f "$live" ]] && [[ "$(<"$live")" != "$expected" ]]; then
		local backup="${live}.pre-agents-link-backup"
		if [[ ! -e "$backup" ]]; then
			cp "$live" "$backup"
			say 'backup:' "Cursor hooks -> $backup"
		else
			say 'error:' "refusing to replace Cursor hooks; backup already exists at $backup" >&2
			failed=1
			return
		fi
	fi
	printf '%s' "$expected" >"$live"
	say 'wrote:' "Cursor portable hooks"
}

link_shared_standard() {
	project_skills "$HOME/.agents/skills" "shared"
}

link_claude() {
	if ! command -v claude >/dev/null 2>&1 && [[ ! -d "$HOME/.claude" ]]; then
		say SKIP "Claude Code is not installed"
		return
	fi
	if [[ "$CHECK" -eq 1 ]]; then
		"$REPO_ROOT/bin/claude_link" --check || failed=1
	else
		"$REPO_ROOT/bin/claude_link" || failed=1
	fi
}

link_codex() {
	if ! command -v codex >/dev/null 2>&1 && [[ ! -d "$HOME/.codex" ]]; then
		say SKIP "Codex is not installed"
		return
	fi
	project_link "$HOME/.codex/AGENTS.md" "$AGENTS_ROOT/AGENTS.md" "Codex global rules"
	project_skills "$HOME/.codex/skills" "Codex"
	say INFO "Codex hooks are supported, but this adapter leaves them native until their TOML schema is stable."
}

link_opencode() {
	if ! command -v opencode >/dev/null 2>&1 && [[ ! -d "$HOME/.config/opencode" ]]; then
		say SKIP "OpenCode is not installed"
		return
	fi
	project_link "$HOME/.config/opencode/AGENTS.md" "$AGENTS_ROOT/AGENTS.md" "OpenCode global rules"
	project_skills "$HOME/.config/opencode/skills" "OpenCode"
	say INFO "OpenCode lifecycle extensions are plugins, not portable command hooks."
}

link_cursor() {
	if ! command -v cursor-agent >/dev/null 2>&1 && ! command -v agent >/dev/null 2>&1 && [[ ! -d "$HOME/.cursor" ]]; then
		say SKIP "Cursor Agent is not installed"
		return
	fi
	project_skills "$HOME/.cursor/skills" "Cursor"
	write_cursor_hooks
	say INFO "Cursor has no verified filesystem-backed global rules path; project AGENTS.md remains required."
}

link_shared_standard
case "$TARGET" in
all)
	link_claude
	link_codex
	link_opencode
	link_cursor
	;;
claude) link_claude ;;
codex) link_codex ;;
opencode) link_opencode ;;
cursor) link_cursor ;;
esac

exit "$failed"
