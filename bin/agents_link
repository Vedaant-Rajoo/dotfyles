#!/usr/bin/env bash
# Project the canonical agents/ rules, skills, subagents, and portable hooks
# into each installed AI harness without taking ownership of provider, auth, or
# UI config.
#
# Rules and skills are the same bytes everywhere, so they are symlinked.
# Subagent frontmatter differs per harness, so those are generated through
# bin/agents_render; this script owns placement, backups, and pruning.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
AGENTS_ROOT="$REPO_ROOT/agents"
RENDER="$REPO_ROOT/bin/agents_render"
CLAUDE_SRC="$REPO_ROOT/claude"
LIVE_CLAUDE="$HOME/.claude"
CLAUDE_TOKEN_FILE="$CLAUDE_SRC/auth-token"
CLAUDE_HELPER="$CLAUDE_SRC/api-key-helper.sh"
. "$REPO_ROOT/bin/lib/ui.sh"
# First body line of every file this script generates; also the ownership marker
# that tells it which files it may rewrite or prune. Anything without it belongs
# to the harness or the user.
GENERATED_HEADER='<!-- generated by bin/agents_link from agents/'
CHECK=0
MIGRATE=0
TARGET="all"
ADOPT_NAME=""
ADOPT_DRY_RUN=0

usage() {
	cat <<'EOF'
usage: agents_link [--check] [all|claude|codex|opencode|cursor]
       agents_link --migrate claude
       agents_link adopt [--dry-run] <name>

  --check    Report drift without changing files.
  --migrate  Fold a real ~/.claude into claude/ first (claude target only),
             backing it up to ~/.claude.pre-migrate-backup, then link.

  adopt      Move ~/.agents/skills/<name> into agents/skills/<name>, then re-run
             the full projection so every harness links the tracked copy.
             --dry-run prints what would move and changes nothing.

Rules, skills, and subagents come from ~/.config/agents. Harness-native settings
remain in that harness's own config; adapters only add links, generated subagent
files, and hook shims.
EOF
}

die() {
	say 'error:' "$*" >&2
	exit 1
}

if [[ "${1:-}" == "adopt" ]]; then
	shift
	for arg in "$@"; do
		case "$arg" in
		--dry-run) ADOPT_DRY_RUN=1 ;;
		-h | --help)
			usage
			exit 0
			;;
		-*)
			usage >&2
			exit 1
			;;
		*)
			[[ -z "$ADOPT_NAME" ]] || die "adopt one skill at a time"
			ADOPT_NAME="$arg"
			;;
		esac
	done
	[[ -n "$ADOPT_NAME" ]] || {
		usage >&2
		exit 1
	}
else
	for arg in "$@"; do
		case "$arg" in
		--check) CHECK=1 ;;
		--migrate) MIGRATE=1 ;;
		all | claude | codex | opencode | cursor) TARGET="$arg" ;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			usage >&2
			exit 1
			;;
		esac
	done
fi

if [[ "$MIGRATE" -eq 1 ]]; then
	if [[ "$CHECK" -eq 1 ]]; then
		echo "agents_link: --check and --migrate are mutually exclusive" >&2
		exit 1
	fi
	if [[ "$TARGET" != "claude" ]]; then
		echo "agents_link: --migrate applies only to the claude target (run: agents_link --migrate claude)" >&2
		exit 1
	fi
fi

failed=0

# Physical location of a path whose parent exists. Resolving the parent rather
# than the path itself keeps symlinked homes and not-yet-created links honest.
physical_path() {
	local dir base
	dir="$(dirname "$1")"
	base="$(basename "$1")"
	if [[ -d "$dir" ]]; then
		printf '%s/%s\n' "$(cd "$dir" && pwd -P)" "$base"
	else
		printf '%s\n' "$1"
	fi
}

is_in_repo() {
	[[ "$(physical_path "$1")" == "$REPO_ROOT"/* ]]
}

# Links stored inside the clone must be relative or they break the moment the
# repository lives under a different home. Links outside it stay absolute.
symlink_target() {
	local live="$1" source="$2"
	if is_in_repo "$live"; then
		python3 -c 'import os, sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' \
			"$source" "$(dirname "$(physical_path "$live")")"
	else
		printf '%s\n' "$source"
	fi
}

# Absolute, normalized path a symlink points at, whether its target is relative
# or absolute. Works on broken links, where realpath(1) has nothing to resolve.
link_target_path() {
	python3 -c 'import os, sys
link = sys.argv[1]
target = os.readlink(link)
if not os.path.isabs(target):
    target = os.path.join(os.path.realpath(os.path.dirname(link)), target)
print(os.path.normpath(target))' "$1"
}

is_same_link() {
	local live="$1" source="$2"
	[[ -L "$live" ]] && [[ "$live" -ef "$source" ]]
}

# Correct means both "resolves to the source" and "is stored in the form this
# repo wants". -ef alone accepts an absolute in-repo link, which resolves here
# and nowhere else.
link_is_correct() {
	local live="$1" source="$2"
	is_same_link "$live" "$source" || return 1
	if is_in_repo "$live" && [[ "$(readlink "$live")" == /* ]]; then
		return 1
	fi
	return 0
}

check_link() {
	local live="$1" source="$2" label="$3"
	if link_is_correct "$live" "$source"; then
		say OK "$label"
		return 0
	fi
	if [[ -L "$live" ]]; then
		say STALE "$label (points to $(readlink "$live"))"
	elif [[ -e "$live" ]]; then
		say BROKEN "$label (not a symlink)"
	else
		say MISSING "$label"
	fi
	return 1
}

link_one() {
	local live="$1" source="$2" label="$3" target
	mkdir -p "$(dirname "$live")"
	if link_is_correct "$live" "$source"; then
		say 'ok:' "$label already linked"
		return 0
	fi
	if [[ -L "$live" ]]; then
		say 'relink:' "$label (was $(readlink "$live"))"
		rm "$live"
	elif [[ -e "$live" ]]; then
		local backup="${live}.pre-agents-link-backup"
		if [[ -e "$backup" ]]; then
			say 'error:' "$label exists and backup already exists at $backup" >&2
			return 1
		fi
		say 'backup:' "$label -> $backup"
		mv "$live" "$backup"
	fi
	target="$(symlink_target "$live" "$source")"
	ln -s "$target" "$live"
	say 'linked:' "$label -> $target"
}

project_link() {
	if [[ "$CHECK" -eq 1 ]]; then
		check_link "$1" "$2" "$3" || failed=1
	else
		link_one "$1" "$2" "$3" || failed=1
	fi
}

# Remove per-skill links whose canonical source is gone. Only links into
# agents/skills are touched: real directories and links owned by a harness or
# another installer are left exactly as they are.
prune_stale_skills() {
	local root="$1" harness="$2" entry skill
	[[ -d "$root" ]] || return 0
	for entry in "$root"/*; do
		[[ -L "$entry" && ! -e "$entry" ]] || continue
		[[ "$(link_target_path "$entry")" == "$AGENTS_ROOT"/skills/* ]] || continue
		skill="$(basename "$entry")"
		if [[ "$CHECK" -eq 1 ]]; then
			say STALE "$harness skill: $skill (canonical source is gone)"
			failed=1
		else
			rm "$entry"
			say 'pruned:' "$harness skill: $skill"
		fi
	done
}

# A real skill directory this repo does not own — usually `npx skills add -g`.
# Reported so it can be adopted or knowingly left alone; never modified.
report_foreign_skills() {
	local root="$1" harness="$2" adoptable="$3" entry skill
	[[ "$CHECK" -eq 1 ]] || return 0
	[[ -d "$root" ]] || return 0
	for entry in "$root"/*; do
		[[ -d "$entry" && ! -L "$entry" && -f "$entry/SKILL.md" ]] || continue
		skill="$(basename "$entry")"
		[[ ! -d "$AGENTS_ROOT/skills/$skill" ]] || continue
		if [[ "$adoptable" -eq 1 ]]; then
			say INFO "skill '$skill' is installed but unmanaged; adopt it with: bin/agents_link adopt $skill"
		else
			say INFO "skill '$skill' is native to $harness only; agents/ does not manage it"
		fi
	done
}

project_skills() {
	local root="$1" harness="$2" adoptable="${3:-0}" skill source live
	if [[ "$CHECK" -eq 1 ]]; then
		if [[ ! -d "$root" ]]; then
			say MISSING "$harness skills root ($root)"
			failed=1
			return
		fi
	else
		mkdir -p "$root"
	fi
	for source in "$AGENTS_ROOT"/skills/*; do
		[[ -d "$source" ]] || continue
		skill="$(basename "$source")"
		live="$root/$skill"
		project_link "$live" "$source" "$harness skill: $skill"
	done
	prune_stale_skills "$root" "$harness"
	report_foreign_skills "$root" "$harness" "$adoptable"
}

check_generated_file() {
	local live="$1" expected="$2" label="$3"
	if [[ ! -e "$live" ]]; then
		say MISSING "$label"
		return 1
	fi
	if [[ ! -f "$live" ]]; then
		say BROKEN "$label (not a regular file)"
		return 1
	fi
	if [[ "$(<"$live")" == "$expected" ]]; then
		say OK "$label"
		return 0
	fi
	say STALE "$label"
	return 1
}

write_generated_file() {
	local live="$1" expected="$2" label="$3" backup
	if [[ -e "$live" ]] && [[ ! -f "$live" ]]; then
		say 'error:' "$label is not a regular file: $live" >&2
		return 1
	fi
	if [[ -f "$live" ]]; then
		if [[ "$(<"$live")" == "$expected" ]]; then
			say 'ok:' "$label already current"
			return 0
		fi
		if ! grep -qF "$GENERATED_HEADER" "$live"; then
			backup="${live}.pre-agents-link-backup"
			if [[ -e "$backup" ]]; then
				say 'error:' "$label was not generated here and $backup already exists" >&2
				return 1
			fi
			say 'backup:' "$label -> $backup"
			mv "$live" "$backup"
		fi
	fi
	printf '%s\n' "$expected" >"$live"
	say 'wrote:' "$label"
}

# Generated files whose source disappeared are ours to remove; anything without
# the generation header belongs to the harness or the user and is only reported.
prune_stale_subagents() {
	local outdir="$1" kind="$2" entry name
	[[ -d "$outdir" ]] || return 0
	for entry in "$outdir"/*.md; do
		[[ -f "$entry" ]] || continue
		name="$(basename "$entry" .md)"
		[[ ! -f "$AGENTS_ROOT/subagents/$name.md" ]] || continue
		if ! grep -qF "$GENERATED_HEADER" "$entry"; then
			if [[ "$CHECK" -eq 1 ]]; then
				say INFO "$kind subagent '$name' was not generated from agents/subagents; left untouched"
			fi
			continue
		fi
		if [[ "$CHECK" -eq 1 ]]; then
			say STALE "$kind subagent: $name (source is gone)"
			failed=1
		else
			rm "$entry"
			say 'pruned:' "$kind subagent: $name"
		fi
	done
}

project_subagents() {
	local outdir="$1" kind="$2" source name live expected label
	if [[ "$CHECK" -eq 1 ]]; then
		if [[ ! -d "$outdir" ]]; then
			say MISSING "$kind subagents root ($outdir)"
			failed=1
			return
		fi
	else
		mkdir -p "$outdir"
	fi
	for source in "$AGENTS_ROOT"/subagents/*.md; do
		[[ -f "$source" ]] || continue
		name="$(basename "$source" .md)"
		[[ "$name" != "README" ]] || continue
		live="$outdir/$name.md"
		label="$kind subagent: $name"
		if ! expected="$("$RENDER" subagent "$source" "$kind")"; then
			say 'error:' "$label did not render" >&2
			failed=1
			continue
		fi
		if [[ "$CHECK" -eq 1 ]]; then
			check_generated_file "$live" "$expected" "$label" || failed=1
		else
			write_generated_file "$live" "$expected" "$label" || failed=1
		fi
	done
	prune_stale_subagents "$outdir" "$kind"
}

# Cursor is the one harness with no global rules *file*. It finds rules by
# walking up from the workspace directory, so ~/.cursor/rules is reached only
# because $HOME is an ancestor — which covers every project under the home
# directory and nothing outside it. A .mdc also needs its own frontmatter, so
# unlike every other harness this copy is generated rather than symlinked.
project_cursor_rule() {
	local root="$HOME/.cursor/rules" live expected
	local label="Cursor global rule"
	live="$root/agents.mdc"
	if [[ "$CHECK" -eq 1 ]]; then
		if [[ ! -d "$root" ]]; then
			say MISSING "Cursor rules root ($root)"
			failed=1
			return
		fi
	else
		mkdir -p "$root"
	fi
	if ! expected="$("$RENDER" cursor-rule)"; then
		say 'error:' "$label did not render" >&2
		failed=1
		return
	fi
	if [[ "$CHECK" -eq 1 ]]; then
		check_generated_file "$live" "$expected" "$label" || failed=1
	else
		write_generated_file "$live" "$expected" "$label" || failed=1
	fi
}

# JSON carries no comment header, so Cursor hook ownership is inferred from
# the command paths: a file is wholly ours only when it has hook commands and
# every one of them points into agents/hooks/. A file the user extended with a
# custom hook still contains our marker commands, but it is not wholly ours —
# the extra commands are configuration this script never generated and must
# not be overwritten silently.
cursor_hooks_wholly_ours() {
	local file="$1" cmd found=0
	# jq missing or the file unparsable both mean "not provably ours"; the
	# caller then preserves the file in a backup instead of overwriting it.
	command -v jq >/dev/null 2>&1 || return 1
	while IFS= read -r cmd; do
		found=1
		case "$cmd" in
		*"$AGENTS_ROOT/hooks/"*) ;;
		*) return 1 ;;
		esac
	done < <(jq -r '.. | objects | .command? | strings' "$file" 2>/dev/null)
	[[ "$found" -eq 1 ]]
}

write_cursor_hooks() {
	local live="$HOME/.cursor/hooks.json"
	local expected
	if ! expected="$("$RENDER" cursor-hooks)"; then
		say 'error:' "could not render Cursor hooks from agents/hooks/manifest.json" >&2
		failed=1
		return
	fi
	if [[ "$CHECK" -eq 1 ]]; then
		if [[ -f "$live" ]] && [[ "$(<"$live")" == "$expected" ]]; then
			say OK "Cursor portable hooks"
		else
			say STALE "Cursor portable hooks"
			failed=1
		fi
		return
	fi
	if [[ -e "$live" ]] && [[ ! -f "$live" ]]; then
		say 'error:' "Cursor hooks path is not a regular file: $live" >&2
		failed=1
		return
	fi
	if [[ -f "$live" ]] && [[ "$(<"$live")" == "$expected" ]]; then
		say 'ok:' "Cursor portable hooks already current"
		return
	fi
	# A wholly-ours file is a previous generation and is replaced outright:
	# backing those up would leave a stale backup that makes the *next* format
	# change refuse to write. Anything else — foreign or user-extended — is
	# preserved in a backup first, and refused while that backup still stands.
	if [[ -f "$live" ]] && ! cursor_hooks_wholly_ours "$live"; then
		local backup="${live}.pre-agents-link-backup"
		if [[ ! -e "$backup" ]]; then
			cp "$live" "$backup"
			say 'backup:' "Cursor hooks -> $backup"
		else
			say 'error:' "refusing to replace Cursor hooks; backup already exists at $backup" >&2
			failed=1
			return
		fi
	fi
	printf '%s' "$expected" >"$live"
	say 'wrote:' "Cursor portable hooks"
}

# ~/.agents is the cross-tool convention: Codex and OpenCode scan it natively,
# and `npx skills --global` installs into it.
link_shared_standard() {
	project_link "$HOME/.agents/AGENTS.md" "$AGENTS_ROOT/AGENTS.md" "shared global rules"
	project_skills "$HOME/.agents/skills" "shared" 1
}

# --- Claude directory ---------------------------------------------------
#
# ~/.claude *is* this repository's claude/ directory. Claude Code owns and
# rewrites its own user config, so a sanitized copy pushed outward could never
# stay true — the live file always won and the tracked one silently rotted.
# Instead the whole directory is symlinked and everything Claude writes lands
# in the working tree as a reviewable diff. Runtime state (sessions, projects,
# caches, plugins) is gitignored; the real config files are tracked.
# Credentials never enter the repo: settings.json carries an apiKeyHelper
# command, and that helper reads the gitignored claude/auth-token.

check_claude_dir() {
	if is_same_link "$LIVE_CLAUDE" "$CLAUDE_SRC"; then
		say OK "~/.claude -> claude/"
		return 0
	fi
	if [[ -L "$LIVE_CLAUDE" ]]; then
		say STALE "~/.claude points at $(readlink "$LIVE_CLAUDE")"
	elif [[ -d "$LIVE_CLAUDE" ]]; then
		say BROKEN "~/.claude is a real directory — run agents_link --migrate claude"
	elif [[ -e "$LIVE_CLAUDE" ]]; then
		say BROKEN "~/.claude exists and is not a directory"
	else
		say MISSING "~/.claude"
	fi
	return 1
}

# settings.json is tracked, so a literal credential in it would be a leak
# rather than a misconfiguration. Treat it as a hard failure.
check_claude_settings() {
	local settings="$CLAUDE_SRC/settings.json"
	if ! command -v jq >/dev/null 2>&1; then
		say BROKEN "claude/settings.json checks need jq (Brewfile installs it)"
		return 1
	fi
	if ! jq empty "$settings" >/dev/null 2>&1; then
		say BROKEN "claude/settings.json is invalid JSON"
		return 1
	fi
	if ! jq -e '(.apiKeyHelper // "") != ""' "$settings" >/dev/null; then
		say BROKEN "claude/settings.json has no apiKeyHelper"
		return 1
	fi
	if ! jq -e '[.. | objects | keys[]] | any(. == "ANTHROPIC_AUTH_TOKEN" or . == "ANTHROPIC_API_KEY") | not' "$settings" >/dev/null; then
		say BROKEN "claude/settings.json contains a literal credential — move it to claude/auth-token"
		return 1
	fi
	say OK "claude/settings.json (tracked, no credentials)"
}

check_claude_helper() {
	if [[ ! -x "$CLAUDE_HELPER" ]]; then
		say BROKEN "claude/api-key-helper.sh is not executable"
		return 1
	fi
	if ! "$CLAUDE_HELPER" >/dev/null 2>&1; then
		say BROKEN "claude/api-key-helper.sh exited non-zero"
		return 1
	fi
	say OK "claude/api-key-helper.sh"
}

check_claude_token() {
	if [[ ! -f "$CLAUDE_TOKEN_FILE" ]]; then
		say MISSING "claude/auth-token (write your CLIProxyAPI token there)"
		return 1
	fi
	if [[ ! -s "$CLAUDE_TOKEN_FILE" ]]; then
		say BROKEN "claude/auth-token is empty"
		return 1
	fi
	# 0600 is not paranoia here: the file sits in a working tree that gets
	# copied, archived, and opened by editors.
	local mode
	mode="$(stat -f '%OLp' "$CLAUDE_TOKEN_FILE" 2>/dev/null || stat -c '%a' "$CLAUDE_TOKEN_FILE")"
	if [[ "$mode" != "600" ]]; then
		say BROKEN "claude/auth-token is mode $mode; expected 600"
		return 1
	fi
	say OK "claude/auth-token"
}

seed_claude_token() {
	if [[ -f "$CLAUDE_TOKEN_FILE" ]]; then
		say 'ok:' "claude/auth-token already exists (left as-is)"
		return 0
	fi
	: >"$CLAUDE_TOKEN_FILE"
	chmod 600 "$CLAUDE_TOKEN_FILE"
	say 'seeded:' "claude/auth-token (empty — write your CLIProxyAPI token into it)"
}

# Not project_link: its generic real-file path would move a live ~/.claude
# aside as a backup. A real directory here means unmigrated history and gets
# a refusal with the migrate advice instead.
link_claude_dir() {
	if is_same_link "$LIVE_CLAUDE" "$CLAUDE_SRC"; then
		say 'ok:' "~/.claude already linked to claude/"
		return 0
	fi
	if [[ -d "$LIVE_CLAUDE" ]] && [[ ! -L "$LIVE_CLAUDE" ]]; then
		say 'error:' "~/.claude is a real directory; run agents_link --migrate claude" >&2
		return 1
	fi
	if [[ -L "$LIVE_CLAUDE" ]]; then
		say 'relink:' "~/.claude (was $(readlink "$LIVE_CLAUDE"))"
		rm "$LIVE_CLAUDE"
	elif [[ -e "$LIVE_CLAUDE" ]]; then
		say 'error:' "~/.claude exists and is not a directory or symlink" >&2
		return 1
	fi
	ln -s "$CLAUDE_SRC" "$LIVE_CLAUDE"
	say 'linked:' "~/.claude -> $CLAUDE_SRC"
}

# Fold a real ~/.claude into the repository. Repo content always wins: anything
# already tracked here stays, and the live copy of it is preserved in the backup
# rather than overwriting the versioned file.
migrate_claude() {
	if is_same_link "$LIVE_CLAUDE" "$CLAUDE_SRC"; then
		say 'ok:' "~/.claude is already this repo's claude/; nothing to migrate"
		return 0
	fi
	if [[ ! -e "$LIVE_CLAUDE" ]]; then
		link_claude_dir
		return
	fi
	if [[ -L "$LIVE_CLAUDE" ]] || [[ ! -d "$LIVE_CLAUDE" ]]; then
		say 'error:' "~/.claude is not a real directory; nothing to migrate" >&2
		return 1
	fi

	local backup="$LIVE_CLAUDE.pre-migrate-backup"
	if [[ -e "$backup" ]]; then
		say 'error:' "backup already exists at $backup; resolve it first" >&2
		return 1
	fi
	# -c clones on APFS, so a 300M+ backup costs almost no space or time.
	if ! cp -Rc "$LIVE_CLAUDE" "$backup" 2>/dev/null; then
		cp -R "$LIVE_CLAUDE" "$backup"
	fi
	say 'backup:' "~/.claude -> $backup"

	local entry name resolved moved=0 kept=0 dropped=0
	shopt -s dotglob
	for entry in "$LIVE_CLAUDE"/*; do
		[[ -e "$entry" || -L "$entry" ]] || continue
		name="$(basename "$entry")"
		# Our own old per-file links point back into the repo; they would become
		# self-referential once ~/.claude is the repo. Resolve one level only:
		# realpath() would follow claude/CLAUDE.md on to agents/AGENTS.md and
		# miss the match, and a raw prefix test would trip over /var vs
		# /private/var.
		if [[ -L "$entry" ]]; then
			resolved="$(python3 -c 'import os, sys
link = sys.argv[1]
target = os.readlink(link)
if not os.path.isabs(target):
    target = os.path.join(os.path.dirname(link), target)
print(os.path.join(os.path.realpath(os.path.dirname(target)), os.path.basename(target)))' "$entry")"
			if [[ "$resolved" == "$CLAUDE_SRC" || "$resolved" == "$CLAUDE_SRC"/* ]]; then
				rm "$entry"
				dropped=$((dropped + 1))
				continue
			fi
		fi
		if [[ -e "$CLAUDE_SRC/$name" ]]; then
			kept=$((kept + 1))
			say 'kept:' "claude/$name (repo copy wins; live copy is in the backup)"
			continue
		fi
		mv "$entry" "$CLAUDE_SRC/$name"
		moved=$((moved + 1))
	done
	shopt -u dotglob
	say 'moved:' "$moved entries into claude/ ($kept kept, $dropped stale links dropped)"

	# One command, so the window where ~/.claude does not exist is as small as
	# possible: a live Claude session would otherwise recreate it as a real dir.
	rm -rf "$LIVE_CLAUDE" && ln -s "$CLAUDE_SRC" "$LIVE_CLAUDE"
	say 'linked:' "~/.claude -> $CLAUDE_SRC"
	say 'next:' "review 'git status' in $REPO_ROOT, then remove $backup once satisfied"
}

link_claude() {
	if ! command -v claude >/dev/null 2>&1 && [[ ! -d "$LIVE_CLAUDE" ]]; then
		say SKIP "Claude Code is not installed"
		return
	fi
	if [[ "$CHECK" -eq 1 ]]; then
		check_claude_dir || failed=1
		check_claude_settings || failed=1
		check_claude_helper || failed=1
		check_claude_token || failed=1
	elif [[ "$MIGRATE" -eq 1 ]]; then
		{ migrate_claude && seed_claude_token; } || failed=1
	else
		{ link_claude_dir && seed_claude_token; } || failed=1
	fi
	project_subagents "$LIVE_CLAUDE/agents" claude
}

link_codex() {
	if ! command -v codex >/dev/null 2>&1 && [[ ! -d "$HOME/.codex" ]]; then
		say SKIP "Codex is not installed"
		return
	fi
	project_link "$HOME/.codex/AGENTS.md" "$AGENTS_ROOT/AGENTS.md" "Codex global rules"
	project_skills "$HOME/.codex/skills" "Codex"
	say INFO "Codex hooks are supported, but this adapter leaves them native until their TOML schema is stable."
	say INFO "Codex has no stable subagent file format, so agents/subagents is not projected there."
}

link_opencode() {
	if ! command -v opencode >/dev/null 2>&1 && [[ ! -d "$HOME/.config/opencode" ]]; then
		say SKIP "OpenCode is not installed"
		return
	fi
	project_link "$HOME/.config/opencode/AGENTS.md" "$AGENTS_ROOT/AGENTS.md" "OpenCode global rules"
	project_skills "$HOME/.config/opencode/skills" "OpenCode"
	project_subagents "$HOME/.config/opencode/agents" opencode
	say INFO "OpenCode lifecycle extensions are plugins, not portable command hooks."
}

link_cursor() {
	if ! command -v cursor-agent >/dev/null 2>&1 && ! command -v agent >/dev/null 2>&1 && [[ ! -d "$HOME/.cursor" ]]; then
		say SKIP "Cursor Agent is not installed"
		return
	fi
	project_cursor_rule
	project_skills "$HOME/.cursor/skills" "Cursor"
	write_cursor_hooks
	say INFO "Cursor finds rules by walking up from the workspace, so the shared rule reaches projects under \$HOME only."
	say INFO "Cursor reads subagents from a workspace .cursor/agents; ~/.cursor/agents is not read, so agents/subagents is not projected there."
	say INFO "Cursor fires no stop hook headless, so the portable stop hook is also registered on sessionEnd."
}

# Promote a skill that an installer (typically `npx skills add --global`) wrote
# straight into ~/.agents/skills, so every harness reads it from one tracked
# copy: the directory moves into agents/skills and the reprojection puts a
# symlink back where it was. Nothing is committed — adopted files came from
# outside this repository, and nothing under agents/ may carry credentials.
adopt_skill() {
	local name="$ADOPT_NAME"
	local source_dir="$HOME/.agents/skills/$name"
	local dest_dir="$AGENTS_ROOT/skills/$name"

	# The name becomes a directory name, a symlink name, and a skill id in four
	# harnesses, so it has to be boring.
	[[ "$name" =~ ^[a-z0-9][a-z0-9._-]*$ ]] ||
		die "'$name' is not a usable skill name (expected ^[a-z0-9][a-z0-9._-]*\$)"

	[[ -e "$source_dir" ]] || die "no skill at $source_dir"

	# A symlink here is already managed — either by this repo or by another tool
	# that owns the real copy. Either way, moving it would move someone else's file.
	[[ ! -L "$source_dir" ]] ||
		die "$source_dir is a symlink to $(readlink "$source_dir"); only a real directory can be adopted"
	[[ -d "$source_dir" ]] || die "$source_dir is not a directory"
	[[ -f "$source_dir/SKILL.md" ]] || die "$source_dir has no SKILL.md, so no harness can load it"

	grep -qxF "name: $name" "$source_dir/SKILL.md" ||
		die "$source_dir/SKILL.md does not declare 'name: $name'; fix the frontmatter first"

	# ~/.claude/skills resolves through claude/skills into agents/skills, so a
	# skill an installer dropped on the Claude side is already at the destination.
	if [[ -e "$dest_dir" ]]; then
		die "$dest_dir already exists — an installer may have written it through
        ~/.claude/skills. Compare the two copies and remove one, then re-run."
	fi

	if [[ "$ADOPT_DRY_RUN" -eq 1 ]]; then
		say INFO "would move $source_dir -> $dest_dir"
		say INFO "would re-run the full projection"
		printf '\n'
		say INFO "contents:"
		find "$source_dir" -type f | sed "s|^$source_dir/|  |"
		return 0
	fi

	mkdir -p "$AGENTS_ROOT/skills"
	mv "$source_dir" "$dest_dir"
	say 'moved:' "$name -> agents/skills/$name"

	printf '\n'
	run_targets
	[[ "$failed" -eq 0 ]] || say INFO "the projection reported drift above; the adopted skill itself is in place"
	failed=0

	printf '\n'
	say 'done:' "$name is now canonical and shared by every installed harness"
	say 'next:' "review it, then track it:"
	printf '  git -C %s status --short agents/skills/%s\n' "$REPO_ROOT" "$name"
	printf '  git -C %s add agents/skills/%s\n' "$REPO_ROOT" "$name"
	say INFO "nothing was committed; adopted files came from outside this repository"
}

run_targets() {
	link_shared_standard
	case "$TARGET" in
	all)
		link_claude
		link_codex
		link_opencode
		link_cursor
		;;
	claude) link_claude ;;
	codex) link_codex ;;
	opencode) link_opencode ;;
	cursor) link_cursor ;;
	esac
}

if [[ -n "$ADOPT_NAME" ]]; then
	adopt_skill
else
	run_targets
fi

exit "$failed"
