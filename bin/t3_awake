#!/usr/bin/env bash
# Hold a parent-bound caffeinate assertion while a T3 Code thread is working.

set -euo pipefail

DB="${T3_AWAKE_DB:-$HOME/.t3/userdata/state.sqlite}"
RUNTIME_JSON="${T3_AWAKE_RUNTIME_JSON:-$HOME/.t3/userdata/server-runtime.json}"
POLL="${T3_AWAKE_POLL:-2}"
IDLE_POLL="${T3_AWAKE_IDLE_POLL:-15}"
LINGER="${T3_AWAKE_LINGER:-30}"
LOG="${T3_AWAKE_LOG:-$HOME/Library/Logs/t3-awake.log}"
STATE_FILE="${T3_AWAKE_STATE:-$HOME/Library/Caches/dev.newedia.t3-awake.state}"
ERRLOG="${LOG%.log}.err"

LABEL="dev.newedia.t3-awake"
DOMAIN="gui/$UID"
CAFFEINATE="/usr/bin/caffeinate"
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

SLEEP_PID=""
WAKE_PID=""
WAKE_FAIL_LOGGED=0

log() {
	local ts
	ts="$(date '+%Y-%m-%dT%H:%M:%S%z')"
	mkdir -p "$(dirname "$LOG")"
	if [ -f "$LOG" ] && [ "$(stat -f %z "$LOG")" -gt 1048576 ]; then : >"$LOG"; fi
	printf '%s %s\n' "$ts" "$*" >>"$LOG"
}

is_pid() { [[ ${1:-} =~ ^[1-9][0-9]*$ ]]; }

t3_server_alive() {
	local runtime pattern pid
	[ -r "$RUNTIME_JSON" ] || return 1
	runtime="$(<"$RUNTIME_JSON")" || return 1
	pattern='"pid"[[:space:]]*:[[:space:]]*([0-9]+)'
	[[ "$runtime" =~ $pattern ]] || return 1
	pid="${BASH_REMATCH[1]}"
	is_pid "$pid" && kill -0 "$pid" 2>/dev/null
}

# 0 busy, 1 idle, 2 unreadable or query error.
db_busy() {
	local out
	[ -r "$DB" ] || return 2
	out="$(sqlite3 -readonly -cmd '.timeout 1000' "$DB" \
		"SELECT EXISTS(SELECT 1 FROM projection_turns WHERE state = 'running')
		     OR EXISTS(SELECT 1 FROM projection_pending_approvals WHERE resolved_at IS NULL);" 2>/dev/null)" || return 2
	[ "$out" = "1" ]
}

t3_probe() {
	if t3_server_alive && db_busy; then printf 'busy\n'; else printf 'idle\n'; fi
}

state_read() {
	local daemon child extra
	[ -r "$STATE_FILE" ] || return 1
	IFS=' ' read -r daemon child extra <"$STATE_FILE" || return 1
	is_pid "$daemon" && is_pid "$child" && [ -z "${extra:-}" ] || return 1
	printf '%s %s\n' "$daemon" "$child"
}

state_matches_current() { [ "$(state_read 2>/dev/null)" = "$$ $WAKE_PID" ]; }

state_write_current() {
	local dir="${STATE_FILE%/*}"
	[ "$dir" != "$STATE_FILE" ] || dir='.'
	[ -n "$dir" ] || dir='/'
	[ -d "$dir" ] || mkdir -p "$dir" 2>/dev/null || return 1
	{ printf '%s %s\n' "$$" "$WAKE_PID" >"$STATE_FILE"; } 2>/dev/null
}

# State is active only when ps verifies the exact direct child recorded on disk.
wake_state() {
	local pair daemon child process pattern
	[ -e "$STATE_FILE" ] || { printf 'inactive\n'; return; }
	pair="$(state_read)" || { printf 'stale\n'; return; }
	read -r daemon child <<<"$pair"
	if ! kill -0 "$daemon" 2>/dev/null || ! kill -0 "$child" 2>/dev/null; then
		printf 'stale\n'; return
	fi
	process="$(/bin/ps -ww -p "$child" -o ppid=,command= 2>/dev/null)" || { printf 'stale\n'; return; }
	pattern='^[[:space:]]*([0-9]+)[[:space:]]+/usr/bin/caffeinate[[:space:]]+-i[[:space:]]+-w[[:space:]]+([0-9]+)[[:space:]]*$'
	if [[ "$process" =~ $pattern ]] && [ "${BASH_REMATCH[1]}" = "$daemon" ] && [ "${BASH_REMATCH[2]}" = "$daemon" ]; then
		printf 'active (pid %s)\n' "$child"
	else
		printf 'stale\n'
	fi
}

wake_fail() {
	if [ "$WAKE_FAIL_LOGGED" -eq 0 ]; then log "$1"; WAKE_FAIL_LOGGED=1; fi
	return 1
}

wake_pid_alive() { is_pid "$WAKE_PID" && kill -0 "$WAKE_PID" 2>/dev/null; }

state_remove_owned() {
	local daemon=''
	if [ -r "$STATE_FILE" ]; then IFS=' ' read -r daemon _ <"$STATE_FILE" || true; fi
	[ "$daemon" != "$$" ] || rm -f "$STATE_FILE" 2>/dev/null || true
}

wake_discard() {
	local pid="$WAKE_PID"
	WAKE_PID=""
	if is_pid "$pid"; then kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; fi
	state_remove_owned
}

wake_up() {
	if wake_pid_alive; then
		if ! state_matches_current && ! state_write_current; then
			wake_discard
			wake_fail "cannot record caffeinate state at $STATE_FILE"
			return 1
		fi
		WAKE_FAIL_LOGGED=0
		return
	fi

	if is_pid "$WAKE_PID"; then wait "$WAKE_PID" 2>/dev/null || true; fi
	WAKE_PID=""
	[ -x "$CAFFEINATE" ] || { wake_fail "caffeinate is unavailable at $CAFFEINATE"; return 1; }
	"$CAFFEINATE" -i -w "$$" &
	WAKE_PID=$!
	if ! wake_pid_alive; then
		wait "$WAKE_PID" 2>/dev/null || true
		WAKE_PID=""
		wake_fail "caffeinate exited before acquiring the wake assertion"
		return 1
	fi
	if ! state_write_current; then
		wake_discard
		wake_fail "cannot record caffeinate state at $STATE_FILE"
		return 1
	fi
	WAKE_FAIL_LOGGED=0
}

wake_down() { wake_discard; WAKE_FAIL_LOGGED=0; }

validate_intervals() {
	local knob value
	for knob in POLL IDLE_POLL; do
		value="${!knob}"
		if [[ ! "$value" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ || ! "$value" =~ [1-9] ]]; then
			printf 'T3_AWAKE_%s must be a positive number, got: %s\n' "$knob" "$value" >&2
			return 78
		fi
	done
	if [[ ! "$LINGER" =~ ^[1-9][0-9]*$ ]]; then
		printf 'T3_AWAKE_LINGER must be a positive whole number, got: %s\n' "$LINGER" >&2
		return 78
	fi
}

watch_cleanup() {
	local rc=$?
	trap - TERM INT HUP
	if is_pid "$SLEEP_PID"; then kill "$SLEEP_PID" 2>/dev/null || true; wait "$SLEEP_PID" 2>/dev/null || true; fi
	SLEEP_PID=""
	wake_down
	return "$rc"
}

cmd_watch() {
	local state='unknown' cached='idle' want interval rc fails=0 existing
	local last_busy now

	validate_intervals || return $?
	last_busy=$((SECONDS - LINGER))
	if [ -e "$STATE_FILE" ]; then
		existing="$(wake_state)"
		case "$existing" in
		active*) printf 'another t3-awake watch owns %s (%s)\n' "$STATE_FILE" "$existing" >&2; return 1 ;;
		*) rm -f "$STATE_FILE" 2>/dev/null || { printf 'cannot clear stale t3-awake state: %s\n' "$STATE_FILE" >&2; return 1; } ;;
		esac
	fi

	trap 'watch_cleanup' EXIT
	trap 'exit 0' TERM INT HUP
	log "watch started (poll=${POLL}s idle=${IDLE_POLL}s linger=${LINGER}s backend=caffeinate-i)"

	while :; do
		if t3_server_alive; then
			interval="$POLL"
			rc=0; db_busy || rc=$?
			case "$rc" in
			0) cached='busy'; fails=0 ;;
			1) cached='idle'; fails=0 ;;
			*)
				fails=$((fails + 1))
				[ "$fails" -ne 5 ] || log "busy query failed for $fails consecutive polls; falling back to idle"
				[ "$fails" -lt 5 ] || cached='idle'
				;;
			esac
			want="$cached"
		else
			interval="$IDLE_POLL"; want='idle'; cached='idle'; fails=0
		fi

		now=$SECONDS
		if [ "$want" = 'busy' ]; then
			last_busy="$now"
			if wake_up; then
				[ "$state" = 'busy' ] || log "busy: wake assertion acquired"
				state='busy'
			fi
		elif [ $((now - last_busy)) -ge "$LINGER" ]; then
			wake_down
			[ "$state" = 'idle' ] || log "idle: wake assertion released after ${LINGER}s linger"
			state='idle'
		fi

		sleep "$interval" & SLEEP_PID=$!
		wait "$SLEEP_PID" 2>/dev/null || true
		SLEEP_PID=""
	done
}

plist_target() { printf '%s/Library/LaunchAgents/%s.plist' "$HOME" "$LABEL"; }
service_loaded() { launchctl print "$DOMAIN/$1" >/dev/null 2>&1; }

wait_for_bootout() {
	local label="$1" tries="${2:-40}" i=0
	while service_loaded "$label"; do
		i=$((i + 1)); [ "$i" -lt "$tries" ] || return 1
		sleep 0.25
	done
}

script_sha() {
	local out
	out="$(/usr/bin/shasum -a 256 "$REPO_DIR/bin/t3_awake")" || return 1
	printf '%s\n' "${out%% *}"
}

valid_sha() { [[ $1 =~ ^[0-9a-f]{64}$ ]]; }
escape_sed_replacement() { printf '%s' "$1" | sed 's/[&|\\]/\\&/g'; }

render_plist() {
	local sha="$1" output="$2" template="$REPO_DIR/launchd/$LABEL.plist" bin_path err_path
	[ -r "$template" ] || { printf 'missing LaunchAgent template: %s\n' "$template" >&2; return 1; }
	bin_path="$(escape_sed_replacement "$REPO_DIR/bin/t3_awake")"
	err_path="$(escape_sed_replacement "$ERRLOG")"
	sed -e "s|__T3_AWAKE_BIN__|$bin_path|g" -e "s|__T3_AWAKE_ERR__|$err_path|g" \
		-e "s|__T3_AWAKE_SHA256__|$sha|g" "$template" >"$output"
}

installed_script_sha() {
	sed -n 's/.*t3-awake-script-sha256: \([0-9a-f][0-9a-f]*\).*/\1/p' "$1" | head -1
}

atomic_write_plist() {
	local source="$1" target="$2" tmp
	mkdir -p "${target%/*}"
	tmp="$(mktemp "${target}.XXXXXX")" || return 1
	if ! /bin/cp "$source" "$tmp" || ! /bin/chmod 644 "$tmp" || ! /bin/mv -f "$tmp" "$target"; then
		rm -f "$tmp" 2>/dev/null || true; return 1
	fi
}

bootstrap_service() {
	local target="$1" out
	if ! out="$(launchctl bootstrap "$DOMAIN" "$target" 2>&1)"; then
		printf 'failed to bootstrap %s from %s\n%s\n' "$LABEL" "$target" "$out" >&2
		printf 'the LaunchAgent is written but not loaded; retry with: bin/t3_awake install\n' >&2
		return 1
	fi
}

kickstart_service() {
	local out
	out="$(launchctl kickstart -k "$DOMAIN/$LABEL" 2>&1)" || { printf 'failed to restart %s\n%s\n' "$LABEL" "$out" >&2; return 1; }
}

cmd_status() {
	local running='?' approvals='?' server='down' agent='not loaded'
	if [ -r "$DB" ]; then
		running="$(sqlite3 -readonly -cmd '.timeout 1000' "$DB" "SELECT COUNT(*) FROM projection_turns WHERE state='running';" 2>/dev/null || echo '?')"
		approvals="$(sqlite3 -readonly -cmd '.timeout 1000' "$DB" "SELECT COUNT(*) FROM projection_pending_approvals WHERE resolved_at IS NULL;" 2>/dev/null || echo '?')"
	fi
	t3_server_alive && server='alive'
	service_loaded "$LABEL" && agent='loaded'
	printf 'database:        %s\nrunning turns:   %s\nopen approvals:  %s\n' "$DB" "$running" "$approvals"
	printf 'T3 Code server:  %s\nwake assertion:  %s\ndesired state:   %s\nlaunch agent:    %s\n' \
		"$server" "$(wake_state)" "$(t3_probe)" "$agent"
}

cmd_install() (
	local dry=0 target desired compare sha old_sha class='structural' loaded=0 key
	case "$#:${1:-}" in
	0:) ;; 1:--dry-run) dry=1 ;;
	*) printf 'usage: bin/t3_awake install [--dry-run]\n' >&2; return 64 ;;
	esac

	target="$(plist_target)"
	desired="$(mktemp "${TMPDIR:-/tmp}/t3-awake-desired.XXXXXX")" || return 1
	compare="$(mktemp "${TMPDIR:-/tmp}/t3-awake-compare.XXXXXX")" || { rm -f "$desired"; return 1; }
	trap 'rm -f "$desired" "$compare"' EXIT
	sha="$(script_sha)" || return 1
	render_plist "$sha" "$desired" || return 1
	plutil -lint "$desired" >/dev/null 2>&1 || { printf 'rendered LaunchAgent is not a valid plist\n' >&2; return 1; }
	service_loaded "$LABEL" && loaded=1

	if [ -f "$target" ] && cmp -s "$desired" "$target"; then
		class='identical'
	elif [ -f "$target" ]; then
		old_sha="$(installed_script_sha "$target")"
		if valid_sha "$old_sha" && render_plist "$old_sha" "$compare" && cmp -s "$compare" "$target"; then class='script'; fi
	fi
	key="$loaded:$class"

	if [ "$dry" -eq 1 ]; then
		case "$key" in
		1:identical) printf 'already installed and loaded; would make no changes\n' ;;
		1:script) printf 'would kickstart -k %s/%s\nwould update %s\n' "$DOMAIN" "$LABEL" "$target" ;;
		1:structural) printf 'would bootout %s/%s and wait for it to unload\nwould write %s\nwould bootstrap %s from %s\n' "$DOMAIN" "$LABEL" "$target" "$DOMAIN" "$target" ;;
		0:identical) printf 'would bootstrap %s from %s\n' "$DOMAIN" "$target" ;;
		0:*) printf 'would write %s\nwould bootstrap %s from %s\n' "$target" "$DOMAIN" "$target" ;;
		esac
		return
	fi

	case "$key" in
	1:identical) printf '%s is already installed and loaded; no changes.\n' "$LABEL" ;;
	1:script)
		kickstart_service || return 1
		atomic_write_plist "$desired" "$target" || { printf '%s restarted, but its revision marker could not be updated at %s\n' "$LABEL" "$target" >&2; return 1; }
		printf 'Restarted %s for the updated script.\n' "$LABEL"
		;;
	1:structural)
		launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 || true
		wait_for_bootout "$LABEL" || { printf 'the running %s did not unload; leaving %s untouched\n' "$LABEL" "$target" >&2; return 1; }
		atomic_write_plist "$desired" "$target" && bootstrap_service "$target" || return 1
		printf 'Installed and loaded %s.\n' "$LABEL"
		;;
	0:identical) bootstrap_service "$target" || return 1; printf 'Loaded %s from the existing plist.\n' "$LABEL" ;;
	0:*) atomic_write_plist "$desired" "$target" && bootstrap_service "$target" || return 1; printf 'Installed and loaded %s.\n' "$LABEL" ;;
	esac
)

cmd_uninstall() {
	local target
	target="$(plist_target)"
	if service_loaded "$LABEL"; then
		launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 || true
		wait_for_bootout "$LABEL" || { printf 'the running %s did not unload; leaving %s in place\n' "$LABEL" "$target" >&2; return 1; }
	fi
	rm -f "$target" "$STATE_FILE"
	printf 'Removed the %s LaunchAgent.\n' "$LABEL"
}

usage() {
	cat <<'EOF'
usage: bin/t3_awake <command>

  probe                 Print "busy" or "idle" for the current state.
  watch                 Run the daemon loop (what launchd runs).
  status                Print a diagnostic summary.
  install [--dry-run]   Reconcile and load the LaunchAgent.
  uninstall             Unload and remove the LaunchAgent.
EOF
}

main() {
	case "${1:-}" in
	probe) t3_probe ;; watch) cmd_watch ;; status) cmd_status ;;
	install) shift; cmd_install "$@" ;; uninstall) cmd_uninstall ;;
	-h | --help | help | '') usage ;;
	*) printf 'unknown command: %s\n' "$1" >&2; usage >&2; return 64 ;;
	esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
