#!/usr/bin/env bash
# claude_link — make ~/.claude *be* this repository's claude/ directory.
#
# Claude Code owns and rewrites its own user config: it has already dropped this
# repo's hooks, permissions, and statusline from settings.json on its own. So
# copying a sanitized settings.json outward could never stay true — the live
# file always won and the tracked one silently rotted.
#
# Instead ~/.claude is a symlink to claude/ in this repo. Whatever Claude writes
# lands in the working tree and shows up as a reviewable git diff, which is the
# only way to keep it honest. Runtime state (sessions, projects, caches, the
# plugin tree) is gitignored; the handful of real config files are tracked.
#
# Credentials never enter the repo. settings.json carries an `apiKeyHelper`
# command instead of a token, and that helper reads claude/auth-token, which is
# gitignored. Everything else in `env` is a localhost URL or a model name.
#
# Usage:
#   claude_link            Ensure the symlink and the local token file exist.
#   claude_link --check    Report status only; make no changes.
#   claude_link --migrate  Fold an existing real ~/.claude into claude/, then link.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
REPO_CLAUDE="$REPO_ROOT/claude"
LIVE_CLAUDE="$HOME/.claude"
TOKEN_FILE="$REPO_CLAUDE/auth-token"
HELPER="$REPO_CLAUDE/api-key-helper.sh"

MODE="link"
case "${1:-}" in
"") ;;
--check) MODE="check" ;;
--migrate) MODE="migrate" ;;
*)
    echo "usage: claude_link [--check|--migrate]" >&2
    exit 1
    ;;
esac

failed=0

# Deliberately not the gum-aware say() used by agents_link: this script is
# invoked by it and inherits its formatting by matching the plain column width.
report() { printf '%-8s%s\n' "$1" "$2"; }

is_linked() {
    [[ -L "$LIVE_CLAUDE" ]] && [[ "$LIVE_CLAUDE" -ef "$REPO_CLAUDE" ]]
}

check_link() {
    if is_linked; then
        report OK "~/.claude -> claude/"
        return 0
    fi
    if [[ -L "$LIVE_CLAUDE" ]]; then
        report STALE "~/.claude points at $(readlink "$LIVE_CLAUDE")"
    elif [[ -d "$LIVE_CLAUDE" ]]; then
        report BROKEN "~/.claude is a real directory — run claude_link --migrate"
    elif [[ -e "$LIVE_CLAUDE" ]]; then
        report BROKEN "~/.claude exists and is not a directory"
    else
        report MISSING "~/.claude"
    fi
    return 1
}

check_token() {
    if [[ ! -f "$TOKEN_FILE" ]]; then
        report MISSING "claude/auth-token (write your CLIProxyAPI token there)"
        return 1
    fi
    if [[ ! -s "$TOKEN_FILE" ]]; then
        report BROKEN "claude/auth-token is empty"
        return 1
    fi
    # 0600 is not paranoia here: the file sits in a working tree that gets
    # copied, archived, and opened by editors.
    local mode
    mode="$(stat -f '%OLp' "$TOKEN_FILE" 2>/dev/null || stat -c '%a' "$TOKEN_FILE")"
    if [[ "$mode" != "600" ]]; then
        report BROKEN "claude/auth-token is mode $mode; expected 600"
        return 1
    fi
    report OK "claude/auth-token"
}

check_helper() {
    if [[ ! -x "$HELPER" ]]; then
        report BROKEN "claude/api-key-helper.sh is not executable"
        return 1
    fi
    if ! "$HELPER" >/dev/null 2>&1; then
        report BROKEN "claude/api-key-helper.sh exited non-zero"
        return 1
    fi
    report OK "claude/api-key-helper.sh"
}

# settings.json is tracked now, so a literal credential in it would be a leak
# rather than a misconfiguration. Treat it as a hard failure.
check_settings() {
    local settings="$REPO_CLAUDE/settings.json"
    if ! python3 -m json.tool "$settings" >/dev/null 2>&1; then
        report BROKEN "claude/settings.json is invalid JSON"
        return 1
    fi
    if ! python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if d.get("apiKeyHelper") else 1)' "$settings"; then
        report BROKEN "claude/settings.json has no apiKeyHelper"
        return 1
    fi
    if python3 -c 'import json,sys
d = json.load(open(sys.argv[1]))
env = d.get("env") or {}
sys.exit(0 if "ANTHROPIC_AUTH_TOKEN" in env or "ANTHROPIC_API_KEY" in env else 1)' "$settings"; then
        report BROKEN "claude/settings.json contains a literal credential — move it to claude/auth-token"
        return 1
    fi
    report OK "claude/settings.json (tracked, no credentials)"
}

seed_token() {
    if [[ -f "$TOKEN_FILE" ]]; then
        report 'ok:' "claude/auth-token already exists (left as-is)"
        return 0
    fi
    : >"$TOKEN_FILE"
    chmod 600 "$TOKEN_FILE"
    report 'seeded:' "claude/auth-token (empty — write your CLIProxyAPI token into it)"
}

link_dir() {
    if is_linked; then
        report 'ok:' "~/.claude already linked to claude/"
        return 0
    fi
    if [[ -d "$LIVE_CLAUDE" ]] && [[ ! -L "$LIVE_CLAUDE" ]]; then
        report 'error:' "~/.claude is a real directory; run claude_link --migrate" >&2
        return 1
    fi
    if [[ -L "$LIVE_CLAUDE" ]]; then
        report 'relink:' "~/.claude (was $(readlink "$LIVE_CLAUDE"))"
        rm "$LIVE_CLAUDE"
    elif [[ -e "$LIVE_CLAUDE" ]]; then
        report 'error:' "~/.claude exists and is not a directory or symlink" >&2
        return 1
    fi
    ln -s "$REPO_CLAUDE" "$LIVE_CLAUDE"
    report 'linked:' "~/.claude -> $REPO_CLAUDE"
}

# Fold a real ~/.claude into the repository. Repo content always wins: anything
# already tracked here stays, and the live copy of it is preserved in the backup
# rather than overwriting the versioned file.
migrate() {
    if is_linked; then
        report 'ok:' "~/.claude is already this repo's claude/; nothing to migrate"
        return 0
    fi
    if [[ ! -e "$LIVE_CLAUDE" ]]; then
        link_dir
        return
    fi
    if [[ -L "$LIVE_CLAUDE" ]] || [[ ! -d "$LIVE_CLAUDE" ]]; then
        report 'error:' "~/.claude is not a real directory; nothing to migrate" >&2
        return 1
    fi

    local backup="$LIVE_CLAUDE.pre-migrate-backup"
    if [[ -e "$backup" ]]; then
        report 'error:' "backup already exists at $backup; resolve it first" >&2
        return 1
    fi
    # -c clones on APFS, so a 300M+ backup costs almost no space or time.
    if ! cp -Rc "$LIVE_CLAUDE" "$backup" 2>/dev/null; then
        cp -R "$LIVE_CLAUDE" "$backup"
    fi
    report 'backup:' "~/.claude -> $backup"

    local entry name resolved moved=0 kept=0 dropped=0
    shopt -s dotglob
    for entry in "$LIVE_CLAUDE"/*; do
        [[ -e "$entry" || -L "$entry" ]] || continue
        name="$(basename "$entry")"
        # Our own old per-file links point back into the repo; they would become
        # self-referential once ~/.claude is the repo. Resolve one level only:
        # realpath() would follow claude/CLAUDE.md on to agents/AGENTS.md and
        # miss the match, and a raw prefix test would trip over /var vs
        # /private/var.
        if [[ -L "$entry" ]]; then
            resolved="$(python3 -c 'import os, sys
link = sys.argv[1]
target = os.readlink(link)
if not os.path.isabs(target):
    target = os.path.join(os.path.dirname(link), target)
print(os.path.join(os.path.realpath(os.path.dirname(target)), os.path.basename(target)))' "$entry")"
            if [[ "$resolved" == "$REPO_CLAUDE" || "$resolved" == "$REPO_CLAUDE"/* ]]; then
                rm "$entry"
                dropped=$((dropped + 1))
                continue
            fi
        fi
        if [[ -e "$REPO_CLAUDE/$name" ]]; then
            kept=$((kept + 1))
            report 'kept:' "claude/$name (repo copy wins; live copy is in the backup)"
            continue
        fi
        mv "$entry" "$REPO_CLAUDE/$name"
        moved=$((moved + 1))
    done
    shopt -u dotglob
    report 'moved:' "$moved entries into claude/ ($kept kept, $dropped stale links dropped)"

    # One command, so the window where ~/.claude does not exist is as small as
    # possible: a live Claude session would otherwise recreate it as a real dir.
    rm -rf "$LIVE_CLAUDE" && ln -s "$REPO_CLAUDE" "$LIVE_CLAUDE"
    report 'linked:' "~/.claude -> $REPO_CLAUDE"
    report 'next:' "review 'git status' in $REPO_ROOT, then remove $backup once satisfied"
}

case "$MODE" in
check)
    check_link || failed=1
    check_settings || failed=1
    check_helper || failed=1
    check_token || failed=1
    exit "$failed"
    ;;
migrate)
    migrate
    seed_token
    ;;
link)
    link_dir
    seed_token
    ;;
esac
