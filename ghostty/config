# Fonts, underlines
# font-family = SFMono Nerd Font
# font-style-italic = Regular Italic
# font-family = Lilex Nerd Font
font-family = JetBrainsMono Nerd Font
font-family-bold = JetBrainsMono Nerd Font
font-family-italic = JetBrainsMono Nerd Font
font-family-bold-italic = JetBrainsMono Nerd Font
font-size = 14
font-feature = -calt, -liga, -dlig
adjust-cell-height = -1
cursor-style = block
cursor-style-blink = true

# Windows, colors and styles
macos-titlebar-style = hidden
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/mocha.icns
window-padding-y = 2
window-padding-x = 2
window-padding-balance = true
theme = Rose Pine
# background = #000000
# background-blur = 30
# background-opacity = 0.80

# macOS stuff
macos-option-as-alt = left
macos-window-shadow = false
shell-integration-features = no-cursor

# Keys
# Ascii device control codes: https://www3.rocketsoftware.com/bluezone/help/v42/en/bzadmin/APPENDIX_C/ASCII_Character_Set.htm
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = super+enter=unbind

# Herdr sessionizer. Cmd-s types the command at a shell prompt; also reachable
# via Ctrl-o in Fish, prefix+f inside Herdr, or the herdr-sessionizer CLI.
keybind = cmd+s=text:herdr-sessionizer\r
