<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- t3-awake-script-sha256: __T3_AWAKE_SHA256__ -->
	<key>Label</key>
	<string>dev.newedia.t3-awake</string>
	<key>ProgramArguments</key>
	<array>
		<string>__T3_AWAKE_BIN__</string>
		<string>watch</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- Deliberately separate from the daemon log. launchd keeps its own file
	     descriptor and offset, so sharing a file that log() truncates would
	     re-inflate it with NUL padding after rotation. -->
	<key>StandardErrorPath</key>
	<string>__T3_AWAKE_ERR__</string>
</dict>
</plist>
