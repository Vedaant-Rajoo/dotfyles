{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "caveman": {
        "type": "local",
        "command": [
          "/Users/newedia/.caveman/bin/caveman-mcp"
        ]
      }
    }
  },
  "providers": {
    "openai": {
      "settings": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/openai/v1"
      }
    },
    "anthropic": {
      "settings": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/anthropic/v1"
      }
    },
    "opencode-go": {
      "settings": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/compat/opencode-go/v1"
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail"
  ]
}
