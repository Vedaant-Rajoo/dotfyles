{
  "permissions": {
    "allow": []
  },
  "model": "gpt-5.6-sol",
  "enabledPlugins": {
    "codex@openai-codex": true,
    "playwright@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/commit-msg-guard.py",
            "timeout": 10,
            "statusMessage": "Checking commit message style"
          }
        ]
      }
    ]
  },
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "tui": "fullscreen"
}
