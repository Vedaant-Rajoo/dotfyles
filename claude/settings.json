{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/newedia/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/newedia/.node_modules/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/newedia/.local/share/mise/installs/node/24/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/newedia/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/newedia/.node_modules/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/newedia/.local/share/mise/installs/node/24/bin/node'",
            "timeout": 30
